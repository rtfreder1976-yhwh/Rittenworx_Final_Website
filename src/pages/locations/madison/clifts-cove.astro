---
import Layout from "../../../layouts/Layout.astro";
import TrustCredentials from "../../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../../components/InlineQuoteForm.astro";

const neighborhoods = [
    {
        name: "Clift's Cove Proper",
        description:
            "The original section along the main boulevard — brick homes with detailed trim packages: crown molding, wainscoting, and painted cabinetry that needs a careful hand to match.",
        responseTime: "Serving this area",
        commonServices: [
            "Custom trim work",
            "Cabinet painting",
            "Hardwood flooring",
            "Exterior repairs",
        ],
    },
    {
        name: "Clift Heights",
        description:
            "Higher up near Rainbow Mountain, these homes see more wind and runoff, which shows up as extra wear on roofs, fascia boards, gutters, and retaining walls.",
        responseTime: "Serving this area",
        commonServices: [
            "Fascia repair",
            "Gutter installation",
            "Deck restoration",
            "Storm damage",
        ],
    },
    {
        name: "The Lakes Section",
        description:
            "Homes near the neighborhood's lakes deal with more ambient moisture, which speeds up exterior paint failure, window sill rot, and deck joint wear.",
        responseTime: "Serving this area",
        commonServices: [
            "Wood rot repair",
            "Exterior painting",
            "Deck sealing",
            "Window casing repair",
        ],
    },
    {
        name: "Rainbow Elementary Area",
        description:
            "The busier, family-heavy streets near the Hughes Road entrance — mostly quick-turnaround work like drywall patches, door adjustments, and fixture swaps.",
        responseTime: "Serving this area",
        commonServices: [
            "Drywall patching",
            "Door adjustment",
            "Fixture installation",
            "General maintenance",
        ],
    },
];

const weatherChallenges = [
    {
        season: "Spring (March-May)",
        challenge: "Mountain Runoff & Storms",
        impact: "Spring storms send a lot of water down off Rainbow Mountain fast. Gutters that aren't sized right for that volume back up and can send water toward the foundation instead of away from it.",
        services:
            "6-inch gutter installation, downspout routing, roof leak repair",
    },
    {
        season: "Summer (June-August)",
        challenge: "Sun Exposure",
        impact: "Decks facing the Tennessee River Valley take direct sun most of the day, which is hard on standard deck stain and can lead to splintering sooner than you'd expect.",
        services:
            "Deck sanding, stain application, wood rot repair",
    },
    {
        season: "Fall (September-November)",
        challenge: "Leaf Drop",
        impact: "The tree cover that makes this neighborhood nice in summer means a lot of leaves in the gutters every fall — enough to clog roof valleys if it isn't cleared.",
        services:
            "Gutter cleanouts, leaf guard installation, roof valley clearing",
    },
    {
        season: "Winter (December-February)",
        challenge: "Freeze-Thaw Cycles",
        impact: "Homes higher up the mountain see sharper temperature swings, which stresses exterior caulking and can separate window trim and fascia over a winter.",
        services:
            "Exterior sealing, trim replacement, weatherstripping, freeze damage repair",
    },
];

const landmarks = [
    {
        name: "The Clift House",
        type: "Community Hub",
        directions:
            "The neighborhood clubhouse near the top of the hill — a useful landmark for finding your way around.",
    },
    {
        name: "Rainbow Mountain Trails",
        type: "Recreation",
        directions:
            "Hiking trails bordering the back of the neighborhood. Homes along that tree line tend to need more exterior upkeep from the shade and moisture.",
    },
    {
        name: "Rainbow Elementary School",
        type: "Education",
        directions:
            "The Madison City school just outside the neighborhood — a draw for families moving into the area.",
    },
];

const competitors = [
    {
        feature: "Craftsmanship Level",
        us: "Careful, detail-focused work",
        others: 'Standard "handyman" quality',
    },
    {
        feature: "Project Management",
        us: "Clear communication, you're not chasing updates",
        others: "Often needs homeowner supervision",
    },
    {
        feature: "Job Site Cleanliness",
        us: "Drop cloths down, vacuumed before we leave",
        others: "Dust and boot prints left behind",
    },
    {
        feature: "Material Quality",
        us: "Quality paint and trim materials",
        others: "Basic big-box materials",
    },
    {
        feature: "Neighborhood Knowledge",
        us: "Familiar with Clift's Cove's HOA standards and architecture",
        others: "Generic, one-size-fits-all approach",
    },
];

const responseTimes = [
    { area: "Clift's Cove Proper", time: "Quick scheduling", distance: "10 min" },
    { area: "Clift Heights", time: "Quick scheduling", distance: "12 min" },
    { area: "The Lakes", time: "Quick scheduling", distance: "10 min" },
    { area: "Ashton Springs", time: "Quick scheduling", distance: "15 min" },
    { area: "Edgewater", time: "Quick scheduling", distance: "18 min" },
    { area: "Downtown Madison", time: "Quick scheduling", distance: "15 min" },
];

const neighborhoodFacts = [
    "One of Madison's established planned communities",
    "Mostly larger custom-built homes",
    "Borders the Rainbow Mountain Greenways",
    "HOA-governed, with architectural standards for exterior work",
    "Zoned for Madison City Schools",
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How quickly can Rittenworx come out for a handyman job in Clift's Cove?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Timing depends on the job, and Roy will go over it with you when you talk. Rittenworx is locally based in Madison, AL, so Clift's Cove is a quick drive for Roy."
          }
        },
        {
          "@type": "Question",
          name: "What handyman services do you offer in Clift's Cove, AL?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In Clift's Cove we provide drywall repair and installation, interior and exterior painting, flooring installation (hardwood, LVP, laminate), garage floor coating (epoxy and polyaspartic), finish carpentry, gutter cleaning, and gutter installation. Roy provides a written estimate up front."
          }
        },
        {
          "@type": "Question",
          name: "Are you licensed and insured to work in Clift's Cove?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Rittenworx is licensed and insured. We are family-owned, run by a handyman with 7+ years serving North Alabama, and we work in Clift's Cove regularly."
          }
        },
        {
          "@type": "Question",
          name: "Do you give free estimates for Clift's Cove handyman jobs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes — estimates are free in Clift's Cove and the surrounding area. You can text a photo of the job to (256) 221-0373, or request an on-site visit for larger projects."
          }
        }
      ]
    }
  ]
};

---

<Layout
  title="Clift's Cove Handyman & Finish Carpentry | Madison AL"
  description="Premium finish carpentry, cabinet painting & elite home maintenance for Clift's Cove in Madison, AL. Licensed handyman, discreet & professional."
  schema={pageSchema}
>
    <!-- Hero Section -->
    <section class="bg-blue-900 text-white py-16">
        <div class="max-w-6xl mx-auto px-4">
            <div class="max-w-3xl">
                <nav class="text-sm text-blue-200 mb-4">
                    <a href="/locations" class="hover:text-white"
                        >Service Areas</a
                    >
                    <span class="mx-2">/</span>
                    <a href="/locations/madison" class="hover:text-white"
                        >Madison</a
                    >
                    <span class="mx-2">/</span>
                    <span class="text-white">Clift's Cove</span>
                </nav>
                <span
                    class="text-orange-400 font-semibold text-sm uppercase tracking-wide"
                    >Madison's Premier Community</span
                >
                <h1 class="text-4xl md:text-5xl font-bold mt-2 mb-4">
                    Handyman &amp; Finish Carpentry for Clift's Cove
                </h1>
                <p class="text-xl text-blue-100 mb-6">
                    Clift's Cove homes tend toward custom trim, tall crown
                    molding, and painted cabinetry that shows every mistake up
                    close. Rittenworx handles the finish carpentry, painting,
                    and general repairs that keep a house like that looking
                    the way it did on day one — without a crew of
                    subcontractors coming through.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a
                        href="/contact"
                        class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                    >
                        Get Free Estimate
                    </a>
                    <a
                        href="tel:2562210373"
                        class="bg-white/10 hover:bg-white/20 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                    >
                        (256) 221-0373
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Stats -->
    <section class="bg-white py-8 border-b">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
                <div>
                    <p class="text-3xl font-bold text-blue-900">On Time</p>
                    <p class="text-gray-600 text-sm">Response Time</p>
                </div>
                <div>
                    <p class="text-3xl font-bold text-blue-900">Careful</p>
                    <p class="text-gray-600 text-sm">Material Selection</p>
                </div>
                <div>
                    <p class="text-3xl font-bold text-blue-900">Quality</p>
                    <p class="text-gray-600 text-sm">Job Site Cleanliness</p>
                </div>
                <div>
                    <p class="text-3xl font-bold text-blue-900">Discreet</p>
                    <p class="text-gray-600 text-sm">Professional Execution</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Neighborhood Section -->
    <section class="py-16 bg-gray-50">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <span
                        class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
                        >Executive Standards</span
                    >
                    <h2 class="text-3xl font-bold text-gray-800 mt-2 mb-6">
                        We Understand Clift's Cove Architecture
                    </h2>
                    <p class="text-gray-600 mb-4">
                        Clift's Cove isn't a standard subdivision — it's
                        mostly large custom-built homes. Interior trim
                        packages here — stacked crown molding, fluted door
                        casings, tall wainscoting — take a different level of
                        carpentry than a builder-grade house.
                    </p>
                    <p class="text-gray-600 mb-4">
                        When we're spraying cabinets in a kitchen or repairing
                        a rotted section of upper-story fascia, we treat it
                        like it's going to be looked at closely — because with
                        an active HOA reviewing exterior work, it will be.
                        Color matching and wood-rot repairs that don't stand
                        out is the standard we work to.
                    </p>
                    <p class="text-gray-600">
                        From the homes bordering Rainbow Mountain in Clift
                        Heights to the ones around the central lakes, we've
                        done enough work in this neighborhood to know what
                        each section of it actually needs.
                    </p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h3 class="text-xl font-bold text-blue-900 mb-4">
                        Clift's Cove Details
                    </h3>
                    <ul class="space-y-3">
                        {
                            neighborhoodFacts.map((fact) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    <span class="text-gray-700">{fact}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Neighborhoods Section -->
    <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-12">
                <span
                    class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
                    >Micro-Location Expertise</span
                >
                <h2 class="text-3xl font-bold text-gray-800 mt-2">
                    Distinct Zones Within Clift's Cove
                </h2>
                <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
                    We intimately know how the challenging topography of the
                    mountain directly impacts your specific street.
                </p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    neighborhoods.map((neighborhood) => (
                        <div class="bg-gray-50 rounded-lg p-6 border-2 border-gray-100 hover:border-blue-200 transition-colors">
                            <h3 class="text-lg font-bold text-blue-900 mb-2">
                                {neighborhood.name}
                            </h3>
                            <p class="text-gray-600 text-sm mb-4">
                                {neighborhood.description}
                            </p>
                            <div>
                                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">
                                    Specialized Focus
                                </p>
                                <div class="flex flex-wrap gap-1">
                                    {neighborhood.commonServices.map(
                                        (service) => (
                                            <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
                                                {service}
                                            </span>
                                        ),
                                    )}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Weather Challenges -->
    <section class="py-16 bg-gray-50">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-12">
                <span
                    class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
                    >Mountain Topography</span
                >
                <h2 class="text-3xl font-bold text-gray-800 mt-2">
                    Combating The Elements
                </h2>
            </div>
            <div class="grid md:grid-cols-2 gap-6">
                {
                    weatherChallenges.map((challenge) => (
                        <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-blue-500">
                            <div class="flex items-center gap-3 mb-3">
                                <div>
                                    <h3 class="font-bold text-gray-800">
                                        {challenge.season}
                                    </h3>
                                    <p class="text-sm text-orange-600 font-medium">
                                        {challenge.challenge}
                                    </p>
                                </div>
                            </div>
                            <p class="text-gray-600 text-sm mb-3">
                                {challenge.impact}
                            </p>
                            <p class="text-xs text-blue-800">
                                <strong>Our Solutions:</strong>{" "}
                                {challenge.services}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mt-2">
                    Why We Outperform Standard Contractors
                </h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full bg-gray-50 rounded-lg overflow-hidden">
                    <thead class="bg-blue-900 text-white">
                        <tr>
                            <th class="px-6 py-4 text-left">The Standard</th>
                            <th class="px-6 py-4 text-left"
                                >Rittenworx Execution</th
                            >
                            <th class="px-6 py-4 text-left"
                                >Average Companies</th
                            >
                        </tr>
                    </thead>
                    <tbody>
                        {
                            competitors.map((row, index) => (
                                <tr
                                    class={
                                        index % 2 === 0
                                            ? "bg-white"
                                            : "bg-gray-50"
                                    }
                                >
                                    <td class="px-6 py-4 font-medium text-gray-800">
                                        {row.feature}
                                    </td>
                                    <td class="px-6 py-4 text-green-600 font-medium">
                                        {row.us}
                                    </td>
                                    <td class="px-6 py-4 text-gray-500">
                                        {row.others}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <InlineQuoteForm />
    <TrustCredentials />

  <!-- SEO: Service cross-links (auto-injected for internal link audit) -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">Our Services</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-3 mb-4">Handyman Services Available in Clift's Cove</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Pick the service you need. Every job in Clift's Cove comes with a written estimate from a licensed and insured handyman.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/services/drywall" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Drywall Repair &amp; Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Holes, cracks, water damage &amp; texture matching.</p>
        </a>
        <a href="/services/painting" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Interior &amp; Exterior Painting</h3>
          <p class="text-sm text-gray-600 mt-1">Walls, trim, cabinets &amp; full house exteriors.</p>
        </a>
        <a href="/services/flooring" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Flooring Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Hardwood, LVP &amp; laminate, professionally installed.</p>
        </a>
        <a href="/services/garage-floor-coating" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Garage Floor Coating</h3>
          <p class="text-sm text-gray-600 mt-1">Epoxy &amp; polyaspartic garage floors.</p>
        </a>
        <a href="/services/finish-carpentry" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Finish Carpentry</h3>
          <p class="text-sm text-gray-600 mt-1">Crown molding, baseboards, wainscoting &amp; built-ins.</p>
        </a>
        <a href="/services/gutter-cleaning" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Gutter Cleaning &amp; Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Full debris removal plus seamless gutter replacement.</p>
        </a>
      </div>
    </div>
  </section>

</Layout>
