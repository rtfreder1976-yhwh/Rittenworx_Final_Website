---
import Layout from "../../../layouts/Layout.astro";
import TrustCredentials from "../../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../../components/InlineQuoteForm.astro";

const neighborhoods = [
    {
        name: "The Links At Canebrake",
        description:
            "Homes alongside the 18-hole Ron Garl golf course. These well-kept properties call for tidy, low-disruption work that doesn't leave a mess on the course side of the property.",
        responseTime: "Next day available",
        commonServices: [
            "Deck building & staining",
            "Exterior door hardware",
            "Trim repair",
            "Cabinet painting",
        ],
    },
    {
        name: "Cog Hill at Canebrake",
        description:
            "Newer construction with more sophisticated architectural finishes. A lot of homeowners here use our HVLP cabinet spraying to update a kitchen without the cost of a full tear-out.",
        responseTime: "Next day available",
        commonServices: [
            "Wainscoting installation",
            "HVLP cabinet painting",
            "Luxury vinyl plank",
            "Baseboard upgrades",
        ],
    },
    {
        name: "Canebrake Founders District",
        description:
            "The original homes around the Founders House, most now 20+ years old. This is where we see the most fascia rot repair and full gutter system replacement.",
        responseTime: "Next day available",
        commonServices: [
            "Fascia rot repair",
            "Seamless gutter install",
            "Exterior pressure washing",
            "Window casing repair",
        ],
    },
    {
        name: "East Lindsay Lane Expansion",
        description:
            "Newer construction feeding into the Canebrake community. We handle a lot of new-homeowner punch lists here — custom shelving, TV mounting, garage storage.",
        responseTime: "Next day available",
        commonServices: [
            "Custom closet shelving",
            "TV & Mount installation",
            "Garage storage racks",
            "Door alignments",
        ],
    },
];

const weatherChallenges = [
    {
        season: "Spring (March-May)",
        challenge: "Thunderstorm Gutter Failure",
        impact: "Straight-line winds are common across Limestone County in spring, and undersized or poorly installed gutters get torn off exposed Canebrake rooflines. We size and mount 6-inch seamless aluminum gutters to hold up to it.",
        services: "6-inch Seamless Gutter Installation, Fascia Repair",
    },
    {
        season: "Summer (June-August)",
        challenge: "Exterior Paint Blistering",
        impact: "Summer heat bakes dark-colored exterior trim and wooden shutters. If the wood wasn't properly primed to begin with, the topcoat fails.",
        services: "Exterior Painting, Wood Refinishing, Caulk Replacement",
    },
    {
        season: "Fall (September-November)",
        challenge: "Deck Joist Moisture Rot",
        impact: "The well-kept lawns here hold moisture well into late fall. Deck joists sitting close to damp soil are the first place rot shows up.",
        services: "Deck Structural Repair, Composite Decking Overlays",
    },
    {
        season: "Winter (December-February)",
        challenge: "Interior Trim Shrinkage",
        impact: "Running the HVAC system nonstop through a hard freeze dries out wooden crown molding enough that it shrinks and cracks the caulk joints — you'll see dark lines appear near white ceilings.",
        services: "Crown Molding Caulk Repair, Finish Carpentry Touchups",
    },
];

const competitors = [
    {
        feature: "Wood Rot Repair",
        us: "PVC and multi-tool splicing that matches the original profile",
        others: "Bondo filler over wood that's still wet",
    },
    {
        feature: "Kitchen Cabinet Upgrades",
        us: "HVLP-sprayed enamel finish",
        others: "Streaky roller marks from a fast, cheap job",
    },
    {
        feature: "Work Environment",
        us: "Zip walls to contain dust",
        others: "Drywall dust pulled straight into your HVAC return",
    },
    {
        feature: "Community Respect",
        us: "Quiet, considerate of the golf course and your neighbors",
        others: "Loud trucks blocking the golf cart path",
    },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How quickly can Rittenworx come out for a handyman job in Canebrake?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Timing depends on the job, and Roy will go over it with you when you talk. Rittenworx is locally based in Madison, AL, so Canebrake is a quick drive for Roy."
          }
        },
        {
          "@type": "Question",
          name: "What handyman services do you offer in Canebrake, AL?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In Canebrake we provide drywall repair and installation, interior and exterior painting, flooring installation (hardwood, LVP, laminate), garage floor coating (epoxy and polyaspartic), finish carpentry, gutter cleaning, and gutter installation. Roy provides a written estimate up front."
          }
        },
        {
          "@type": "Question",
          name: "Are you licensed and insured to work in Canebrake?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Rittenworx is licensed and insured. We are family-owned, run by a handyman with 7+ years serving North Alabama, and we work in Canebrake regularly."
          }
        },
        {
          "@type": "Question",
          name: "Do you give free estimates for Canebrake handyman jobs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes — estimates are free in Canebrake and the surrounding area. You can text a photo of the job to (256) 221-0373, or request an on-site visit for larger projects."
          }
        }
      ]
    }
  ]
};

---

<Layout
  title="Canebrake Handyman & Finish Carpentry | Athens, AL"
  description="Expert finish carpentry, HVLP cabinet painting & quality home maintenance for Canebrake homeowners in Athens, AL. Discreet, professional service."
  schema={pageSchema}
>
    <!-- Hero Section -->
    <section class="bg-blue-900 text-white py-16">
        <div class="max-w-6xl mx-auto px-4">
            <div class="max-w-3xl">
                <nav class="text-sm text-blue-200 mb-4">
                    <a href="/locations" class="hover:text-white"
                        >Service Areas</a
                    >
                    <span class="mx-2">/</span>
                    <a href="/locations/athens" class="hover:text-white"
                        >Athens</a
                    >
                    <span class="mx-2">/</span>
                    <span class="text-white">Canebrake</span>
                </nav>
                <span
                    class="text-orange-400 font-semibold text-sm uppercase tracking-wide"
                    >Athens' Premier Country Club Community</span
                >
                <h1 class="text-4xl md:text-5xl font-bold mt-2 mb-4">
                    Handyman &amp; Finish Carpentry for Canebrake Estates
                </h1>
                <p class="text-xl text-blue-100 mb-6">
                    Living on an 18-hole golf course means your home's
                    exterior is always on display. Rittenworx handles finish
                    carpentry, cabinet painting, and repairs for Canebrake
                    homeowners who want it done carefully and without a mess
                    left behind.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a
                        href="/contact"
                        class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                    >
                        Get Free Estimate
                    </a>
                    <a
                        href="tel:2562210373"
                        class="bg-white/10 hover:bg-white/20 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                    >
                        (256) 221-0373
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Neighborhood Breakdown -->
    <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-12">
                <span
                    class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
                    >Highly Nuanced Expertise</span
                >
                <h2 class="text-3xl font-bold text-gray-800 mt-2">
                    Intimate Canebrake Knowledge
                </h2>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    neighborhoods.map((neighborhood) => (
                        <div class="bg-gray-50 rounded-lg p-6 border-2 border-gray-100 hover:border-blue-200 transition-colors">
                            <h3 class="text-lg font-bold text-blue-900 mb-2">
                                {neighborhood.name}
                            </h3>
                            <p class="text-gray-600 text-sm mb-4">
                                {neighborhood.description}
                            </p>
                            <div>
                                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">
                                    Specialized Focus
                                </p>
                                <div class="flex flex-wrap gap-1">
                                    {neighborhood.commonServices.map(
                                        (service) => (
                                            <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
                                                {service}
                                            </span>
                                        ),
                                    )}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Weather & Demographics -->
    <section class="py-16 bg-gray-50">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <span
                        class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
                        >Limestone County Elements</span
                    >
                    <h2 class="text-3xl font-bold text-gray-800 mt-2 mb-6">
                        Repairing Wood Rot & Modernizing Kitchens
                    </h2>
                    <p class="text-gray-600 mb-4">
                        Canebrake's architecture is well-kept overall, but the
                        older 1990s sections of the neighborhood still have a
                        lot of original golden honey-oak kitchen cabinets that
                        read as dated next to newer finishes.
                    </p>
                    <p class="text-gray-600 mb-4">
                        For interior renovations, our HVLP sprayers apply a
                        smooth, streak-free urethane enamel finish to those
                        cabinets — no brush marks, no sanding lines — which
                        modernizes a kitchen for a fraction of what a full
                        cabinet replacement costs.
                    </p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h3 class="text-xl font-bold text-blue-900 mb-4">
                        The Combative Elements
                    </h3>
                    <ul class="space-y-3">
                        {
                            weatherChallenges.map((challenge) => (
                                <li class="flex items-start gap-3">
                                    <span class="text-gray-700">
                                        <strong>{challenge.season}:</strong>{" "}
                                        {challenge.impact}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <InlineQuoteForm />
    <TrustCredentials />

  <!-- SEO: Service cross-links (auto-injected for internal link audit) -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">Our Services</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-3 mb-4">Handyman Services Available in Canebrake</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Pick the service you need. Every job in Canebrake comes with a written estimate from a licensed and insured handyman.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/services/drywall" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Drywall Repair &amp; Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Holes, cracks, water damage &amp; texture matching.</p>
        </a>
        <a href="/services/painting" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Interior &amp; Exterior Painting</h3>
          <p class="text-sm text-gray-600 mt-1">Walls, trim, cabinets &amp; full house exteriors.</p>
        </a>
        <a href="/services/flooring" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Flooring Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Hardwood, LVP &amp; laminate, professionally installed.</p>
        </a>
        <a href="/services/garage-floor-coating" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Garage Floor Coating</h3>
          <p class="text-sm text-gray-600 mt-1">Epoxy &amp; polyaspartic garage floors.</p>
        </a>
        <a href="/services/finish-carpentry" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Finish Carpentry</h3>
          <p class="text-sm text-gray-600 mt-1">Crown molding, baseboards, wainscoting &amp; built-ins.</p>
        </a>
        <a href="/services/gutter-cleaning" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Gutter Cleaning &amp; Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Full debris removal plus seamless gutter replacement.</p>
        </a>
      </div>
    </div>
  </section>

</Layout>
