---
import Layout from "../../../layouts/Layout.astro";
import TrustCredentials from "../../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../../components/InlineQuoteForm.astro";

const neighborhoods = [
    {
        name: "Burningtree Country Club",
        description:
            "Homes immediately surrounding the 18-hole George Cobb golf course and country club. These legacy homes call for detailed finish carpentry and cabinet painting that matches their existing high-end finishes.",
        responseTime: "Serving this area",
        commonServices: [
            "Custom trim & molding",
            "HVLP cabinet painting",
            "Hardwood flooring repair",
            "Wainscoting",
        ],
    },
    {
        name: "Burningtree Estates",
        description:
            "Established, heavily wooded lots radiating outward from the club. The tree canopy combined with the age of these 1970s and 1980s homes means we see a lot of fascia rot repair and full gutter system replacement here.",
        responseTime: "Serving this area",
        commonServices: [
            "Fascia rot replacement",
            "Seamless gutter install",
            "Deck structural repair",
            "Exterior painting",
        ],
    },
    {
        name: "Indian Hills Border",
        description:
            "Established properties adjacent to the Burningtree area. A common project here is replacing dated 1980s hollow-core interior doors with solid-core replacements.",
        responseTime: "Serving this area",
        commonServices: [
            "Solid core doors",
            "Drywall finishing",
            "Trim baseboards",
            "Fixture upgrades",
        ],
    },
    {
        name: "Highway 67 Corridor",
        description:
            "Properties near the Highway 67 access points. Busy households here mostly need us for general maintenance and honey-do list items rather than big renovation projects.",
        responseTime: "Serving this area",
        commonServices: [
            "General maintenance",
            "TV mounting",
            "Door alignments",
            "Rapid drywall patches",
        ],
    },
];

const weatherChallenges = [
    {
        season: "Spring (March-May)",
        challenge: "Storm Tree Debris",
        impact: "Burningtree's mature tree canopy means spring thunderstorms bring down branches that damage gutters and tear through aging fascia boards.",
        services:
            "Gutter replacement, fascia board splicing, roofline sealing",
    },
    {
        season: "Summer (June-August)",
        challenge: "Humidity Trapping",
        impact: "The forested geography traps summer humidity against the house, which accelerates exterior paint bubbling, sealant failure, and deck-joist rot you won't notice until it's advanced.",
        services:
            "Exterior sealing, wood rot repair, deck staining",
    },
    {
        season: "Fall (September-November)",
        challenge: "Leaf Clogging",
        impact: "The volume of oak leaves here is enough to clog even well-maintained rooflines. Clogged gutters back water up into the soffits if they're not cleared regularly.",
        services:
            "Gutter cleanouts, leaf guard installation, soffit repair",
    },
    {
        season: "Winter (December-February)",
        challenge: "Deep Freeze Trim Shock",
        impact: "Running the HVAC nonstop during a hard freeze dries out wooden crown molding enough that it shrinks and cracks the caulk joints along the ceiling.",
        services:
            "Crown molding caulk repair, finish carpentry touchups, weatherstripping",
    },
];

const competitors = [
    {
        feature: "Wood Rot Repair",
        us: "PVC and multi-tool splicing that matches the original profile",
        others: "Bondo filler over wood that's still wet",
    },
    {
        feature: "Kitchen Cabinet Upgrades",
        us: "HVLP-sprayed enamel finish",
        others: "Streaky roller marks from a fast, cheap job",
    },
    {
        feature: "Job Site Integrity",
        us: "Zip walls, floor protection, and shoe covers",
        others: "Muddy boots tracked through the house",
    },
    {
        feature: "Estimation Process",
        us: "Written, itemized estimate before we start",
        others: "A vague number scribbled on a napkin",
    },
];

const neighborhoodFacts = [
    "One of Decatur's established, higher-end planned communities",
    "Anchored by the Burningtree Country Club",
    "Legacy estates mostly built in the 1970s and 1980s",
    "Heavily forested, which means more exterior maintenance than a newer, open-lot neighborhood",
    "Located in Southeast Decatur with easy access to I-65 and Highway 67",
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How quickly can Rittenworx come out for a handyman job in Burningtree?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Timing depends on the job, and Roy will go over it with you when you talk. Rittenworx is locally based in Madison, AL, so Burningtree is a quick drive for Roy."
          }
        },
        {
          "@type": "Question",
          name: "What handyman services do you offer in Burningtree, AL?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "In Burningtree we provide drywall repair and installation, interior and exterior painting, flooring installation (hardwood, LVP, laminate), garage floor coating (epoxy and polyaspartic), finish carpentry, gutter cleaning, and gutter installation. Roy provides a written estimate up front."
          }
        },
        {
          "@type": "Question",
          name: "Are you licensed and insured to work in Burningtree?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Rittenworx is licensed and insured. We are family-owned, run by a handyman with 7+ years serving North Alabama, and we work in Burningtree regularly."
          }
        },
        {
          "@type": "Question",
          name: "Do you give free estimates for Burningtree handyman jobs?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes — estimates are free in Burningtree and the surrounding area. You can text a photo of the job to (256) 221-0373, or request an on-site visit for larger projects."
          }
        }
      ]
    }
  ]
};

---

<Layout
  title="Burningtree Handyman & Finish Carpentry | Decatur AL"
  description="Expert finish carpentry, HVLP cabinet painting & home maintenance for Burningtree in Decatur, AL. Licensed handyman, free estimates."
  schema={pageSchema}
>
    <!-- Hero Section -->
    <section class="bg-blue-900 text-white py-16">
        <div class="max-w-6xl mx-auto px-4">
            <div class="max-w-3xl">
                <nav class="text-sm text-blue-200 mb-4">
                    <a href="/locations" class="hover:text-white"
                        >Service Areas</a
                    >
                    <span class="mx-2">/</span>
                    <a href="/locations/decatur" class="hover:text-white"
                        >Decatur</a
                    >
                    <span class="mx-2">/</span>
                    <span class="text-white">Burningtree</span>
                </nav>
                <span
                    class="text-orange-400 font-semibold text-sm uppercase tracking-wide"
                    >Decatur's Premier Country Club Community</span
                >
                <h1 class="text-4xl md:text-5xl font-bold mt-2 mb-4">
                    Handyman &amp; Finish Carpentry for Burningtree Estates
                </h1>
                <p class="text-xl text-blue-100 mb-6">
                    Whether your home sits on the 18th hole of Burningtree
                    Country Club or under the oak canopy of Burningtree
                    Estates, these legacy homes deserve careful finish
                    carpentry and repair work — not a rushed job from whoever
                    was cheapest.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a
                        href="/contact"
                        class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                    >
                        Get Free Estimate
                    </a>
                    <a
                        href="tel:2562210373"
                        class="bg-white/10 hover:bg-white/20 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                    >
                        (256) 221-0373
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Neighborhood Breakdown -->
    <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-12">
                <span
                    class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
                    >Highly Nuanced Expertise</span
                >
                <h2 class="text-3xl font-bold text-gray-800 mt-2">
                    Intimate Burningtree Knowledge
                </h2>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    neighborhoods.map((neighborhood) => (
                        <div class="bg-gray-50 rounded-lg p-6 border-2 border-gray-100 hover:border-blue-200 transition-colors">
                            <h3 class="text-lg font-bold text-blue-900 mb-2">
                                {neighborhood.name}
                            </h3>
                            <p class="text-gray-600 text-sm mb-4">
                                {neighborhood.description}
                            </p>
                            <div>
                                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">
                                    Specialized Focus
                                </p>
                                <div class="flex flex-wrap gap-1">
                                    {neighborhood.commonServices.map(
                                        (service) => (
                                            <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
                                                {service}
                                            </span>
                                        ),
                                    )}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Weather & Demographics -->
    <section class="py-16 bg-gray-50">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <span
                        class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
                        >The Forest Environment</span
                    >
                    <h2 class="text-3xl font-bold text-gray-800 mt-2 mb-6">
                        Repairing Wood Rot & Modernizing Kitchens
                    </h2>
                    <p class="text-gray-600 mb-4">
                        Burningtree's established tree canopy is a big part of
                        its character, but it also traps humidity against the
                        painted exteriors of these legacy 1980s homes.
                    </p>
                    <p class="text-gray-600 mb-4">
                        Rolling fresh paint over damp, rotting window sills is
                        how a paint job peels within a year. We remove the
                        soft wood, splice in PVC where it's rotted past the
                        point of saving, and seal it properly before any paint
                        goes on.
                    </p>
                    <p class="text-gray-600">
                        For interior work, our HVLP sprayers apply a smooth,
                        streak-free enamel finish to the honey-oak kitchen
                        cabinets that are common in this neighborhood —
                        modernizing the kitchen without a full cabinet
                        replacement.
                    </p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h3 class="text-xl font-bold text-blue-900 mb-4">
                        Burningtree Details
                    </h3>
                    <ul class="space-y-3">
                        {
                            neighborhoodFacts.map((fact) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    <span class="text-gray-700">{fact}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Weather Challenges -->
    <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mt-2">
                    Combating The Southeast Decatur Elements
                </h2>
            </div>
            <div class="grid md:grid-cols-2 gap-6">
                {
                    weatherChallenges.map((challenge) => (
                        <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-blue-500">
                            <div class="flex items-center gap-3 mb-3">
                                <div>
                                    <h3 class="font-bold text-gray-800">
                                        {challenge.season}
                                    </h3>
                                    <p class="text-sm text-orange-600 font-medium">
                                        {challenge.challenge}
                                    </p>
                                </div>
                            </div>
                            <p class="text-gray-600 text-sm mb-3">
                                {challenge.impact}
                            </p>
                            <p class="text-xs text-blue-800">
                                <strong>Our Solutions:</strong>{" "}
                                {challenge.services}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <InlineQuoteForm />
    <TrustCredentials />

  <!-- SEO: Service cross-links (auto-injected for internal link audit) -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">Our Services</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-3 mb-4">Handyman Services Available in Burningtree</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Pick the service you need. Every job in Burningtree comes with a written estimate from a licensed and insured handyman.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/services/drywall" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Drywall Repair &amp; Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Holes, cracks, water damage &amp; texture matching.</p>
        </a>
        <a href="/services/painting" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Interior &amp; Exterior Painting</h3>
          <p class="text-sm text-gray-600 mt-1">Walls, trim, cabinets &amp; full house exteriors.</p>
        </a>
        <a href="/services/flooring" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Flooring Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Hardwood, LVP &amp; laminate, professionally installed.</p>
        </a>
        <a href="/services/garage-floor-coating" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Garage Floor Coating</h3>
          <p class="text-sm text-gray-600 mt-1">Epoxy &amp; polyaspartic garage floors.</p>
        </a>
        <a href="/services/finish-carpentry" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Finish Carpentry</h3>
          <p class="text-sm text-gray-600 mt-1">Crown molding, baseboards, wainscoting &amp; built-ins.</p>
        </a>
        <a href="/services/gutter-cleaning" class="block bg-gray-50 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Gutter Cleaning &amp; Installation</h3>
          <p class="text-sm text-gray-600 mt-1">Full debris removal plus seamless gutter replacement.</p>
        </a>
      </div>
    </div>
  </section>

</Layout>
