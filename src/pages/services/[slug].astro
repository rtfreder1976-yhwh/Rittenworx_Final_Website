---
import Layout from "../../layouts/Layout.astro";
import TrustCredentials from "../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../components/InlineQuoteForm.astro";

export function getStaticPaths() {
    const services = [
        {
            id: "drywall-repair",
            name: "Drywall Repair",
            shortDesc: "Professional drywall patching and repair",
        },
        {
            id: "interior-painting",
            name: "Interior Painting",
            shortDesc: "High-quality interior painting services",
        },
        {
            id: "exterior-painting",
            name: "Exterior Painting",
            shortDesc: "Durable exterior house painting",
        },
        {
            id: "gutter-cleaning",
            name: "Gutter Cleaning",
            shortDesc: "Thorough gutter cleaning and maintenance",
        },
        {
            id: "gutter-installation",
            name: "Gutter Installation",
            shortDesc: "Seamless gutter and downspout installation",
        },
        {
            id: "flooring-installation",
            name: "Flooring Installation",
            shortDesc: "Expert hardwood, LVP, and laminate flooring installation",
        },
        {
            id: "garage-floor-coating",
            name: "Garage Floor Coating",
            shortDesc: "Professional epoxy and flake garage floor coating systems",
        },
        {
            id: "finish-carpentry",
            name: "Finish Carpentry",
            shortDesc: "Custom trim, crown molding, and woodwork",
        },
        {
            id: "fence-installation",
            name: "Fence Installation",
            shortDesc: "Wood fence installation and repair",
        },
        {
            id: "deck-repair",
            name: "Deck Repair",
            shortDesc: "Deck repair, staining, and building",
        },
        {
            id: "pressure-washing",
            name: "Pressure Washing",
            shortDesc: "Pressure and soft washing for homes and hardscapes",
        },
    ];
    const cities = [
        "madison-al",
        "huntsville-al",
        "athens-al",
        "decatur-al",
        "harvest-al",
        "owens-cross-roads-al",
        "hampton-cove-al",
        "redstone-arsenal-al",
        "meridianville-al"
    ];

    const paths: any[] = [];

    services.forEach((service) => {
        cities.forEach((city) => {
            const cityNameObj: Record<string, {name: string, path: string}> = {
                "madison-al": { name: "Madison", path: "madison" },
                "huntsville-al": { name: "Huntsville", path: "huntsville" },
                "athens-al": { name: "Athens", path: "athens" },
                "decatur-al": { name: "Decatur", path: "decatur" },
                "harvest-al": { name: "Harvest", path: "madison/harvest" },
                "owens-cross-roads-al": { name: "Owens Cross Roads", path: "owens-cross-roads" },
                "hampton-cove-al": { name: "Hampton Cove", path: "huntsville/hampton-cove" },
                "redstone-arsenal-al": { name: "Redstone Arsenal", path: "redstone-arsenal" },
                "meridianville-al": { name: "Meridianville", path: "huntsville" }
            };
            const cityData = cityNameObj[city];
            paths.push({
                params: { slug: `${service.id}-${city}` },
                props: { service, city: cityData.name, cityPath: cityData.path, fullCity: city },
            });
        });
    });

    return paths;
}

const { service, city, cityPath, fullCity } = Astro.props;
const { slug } = Astro.params;

// Area-specific context so each service+town page says something true and
// local instead of swapping the town name into identical copy. Facts here
// come from the published location pages for each area.
type Trait = "wooded" | "older" | "newBuild" | "storms" | "pcs" | "rural";
const areaContext: Record<string, { intro: string; traits: Trait[]; link?: { href: string; label: string } }> = {
    "madison-al": {
        intro: "Madison is mostly subdivision homes built over the last few decades, many of them owned by families who work at Redstone Arsenal and Cummings Research Park.",
        traits: ["newBuild", "pcs"],
        link: { href: "/locations/madison/", label: "Madison service area" },
    },
    "huntsville-al": {
        intro: "Huntsville covers everything from older ranch homes in established neighborhoods to new construction on the edges of town, so no two jobs look the same.",
        traits: ["older", "newBuild", "pcs"],
        link: { href: "/locations/huntsville/", label: "Huntsville service area" },
    },
    "athens-al": {
        intro: "Athens mixes historic homes near the square with newer subdivisions spreading toward I-65 and the Madison line.",
        traits: ["older", "newBuild"],
        link: { href: "/locations/athens/", label: "Athens service area" },
    },
    "decatur-al": {
        intro: "Decatur has a large stock of established homes, plus newer neighborhoods like Burningtree, and sits right on the Tennessee River.",
        traits: ["older", "storms"],
        link: { href: "/locations/decatur/", label: "Decatur service area" },
    },
    "harvest-al": {
        intro: "Harvest is a mix of rural-suburban lots, older farmhouses, and new subdivisions along the Highway 53 corridor. Its open terrain gets the full force of North Alabama's spring storms.",
        traits: ["rural", "storms", "newBuild"],
        link: { href: "/locations/madison/harvest/", label: "Harvest service area" },
    },
    "owens-cross-roads-al": {
        intro: "Owens Cross Roads runs from long-time family homes at the foot of Green Mountain to fast-growing new subdivisions near Hampton Cove.",
        traits: ["wooded", "newBuild", "rural"],
        link: { href: "/locations/owens-cross-roads/", label: "Owens Cross Roads service area" },
    },
    "hampton-cove-al": {
        intro: "Many original Hampton Cove homes are 20+ years old, and lots near Monte Sano are heavily wooded. Both shape what needs fixing here.",
        traits: ["older", "wooded", "pcs"],
        link: { href: "/locations/huntsville/hampton-cove/", label: "Hampton Cove service area" },
    },
    "redstone-arsenal-al": {
        intro: "We work for Redstone Arsenal families at their off-post homes in Madison, Huntsville, and Owens Cross Roads. On-post privatized housing has its own maintenance process through the housing partner.",
        traits: ["pcs"],
        link: { href: "/locations/redstone-arsenal/", label: "Redstone Arsenal families" },
    },
    "meridianville-al": {
        intro: "Meridianville is an unincorporated community north of Huntsville along the US-231/431 corridor, with a mix of rural lots and newer subdivisions.",
        traits: ["rural", "newBuild"],
        link: { href: "/locations/huntsville/", label: "Huntsville-area service" },
    },
};

const serviceTraitNotes: Record<string, Partial<Record<Trait, string>>> = {
    "drywall-repair": {
        older: "Older homes settle, so we see a lot of stress cracks over doors and windows and nail pops along ceiling seams.",
        newBuild: "In newer homes the common call is builder-grade tape seams that crack in the first few years as framing dries out.",
        storms: "After storms, we often cut out and replace ceiling drywall stained by roof or window leaks once the leak itself is fixed.",
        pcs: "For PCS moves, we patch anchor holes, dings, and door-knob damage so walls are ready for paint or final inspection.",
        rural: "On rural properties we also handle drywall in shops, bonus rooms, and finished outbuildings.",
        wooded: "Shaded, damp lots can mean moisture-damaged drywall in basements and bathrooms, so we check for the source before patching.",
    },
    "interior-painting": {
        older: "Older homes often have glossy or oil-based trim that needs proper prep and a bonding primer before new paint will stick.",
        newBuild: "Many newer homes still have flat builder paint that marks easily; a scrubbable eggshell or satin finish holds up far better.",
        pcs: "For PCS move-outs, we repaint to a neutral color quickly so the house is ready to list or hand back.",
        storms: "Water-stained ceilings from storm leaks need a stain-blocking primer, or the stain bleeds right back through.",
        rural: "Larger farmhouse-style homes often mean high ceilings and long trim runs, which we price by scope, not a flat rate.",
        wooded: "Homes on wooded lots get less natural light, which changes how colors read. We'll paint sample patches before you commit.",
    },
    "exterior-painting": {
        older: "Older siding and trim usually need scraping, wood repair, and caulking before paint, and that prep is where most of the job's life comes from.",
        newBuild: "Builder exterior paint is often thin; the first repaint on a newer home is a chance to upgrade to a better coating.",
        storms: "Hail and wind-driven rain chip and peel exterior paint fast, especially on south and west faces.",
        wooded: "Shaded, wooded lots grow mildew on siding, so we wash and treat before painting so it doesn't come back through.",
        pcs: "Freshening exterior trim and doors is one of the cheapest ways to boost curb appeal before a PCS sale.",
        rural: "Rural properties often include barns, sheds, and fencing we can paint in the same trip.",
    },
    "gutter-cleaning": {
        wooded: "Tree cover means gutters here clog fast, often more than twice a year, and roof valleys collect debris too.",
        older: "Older gutters often sag or pull from the fascia once they've held standing water; we flag that while we're up there.",
        storms: "After big storms we clear branches and debris before the next rain backs water under the shingles.",
        newBuild: "Newer neighborhoods with young trees still collect pine straw and seed pods, so a yearly cleaning is usually enough.",
        rural: "Rural lots with tall hardwoods drop a lot of leaves in late fall; timing the cleaning after leaf-drop matters.",
        pcs: "A gutter cleaning is an easy item to knock off a pre-listing or move-out checklist.",
    },
    "gutter-installation": {
        older: "On older homes we check and replace rotted fascia before hanging new seamless gutters, since gutters are only as solid as the board behind them.",
        storms: "Heavy North Alabama downpours overwhelm undersized gutters, so we size gutters and downspouts for the roof area.",
        wooded: "On wooded lots, gutter guards can cut down on cleanings. We'll tell you honestly whether they're worth it for your trees.",
        newBuild: "Some newer homes were built with gutters only on part of the roof; adding runs where water splashes the foundation is common work.",
        rural: "Rural homes and outbuildings often need longer runs and extended downspouts to move water away from foundations.",
        pcs: "Damaged or missing gutters often show up on home inspection reports during a sale.",
    },
    "flooring-installation": {
        older: "Older homes often have uneven subfloors that need leveling before LVP or hardwood will lay flat and stay quiet.",
        newBuild: "In newer homes, replacing builder carpet with LVP or hardwood is one of the most common upgrades we do.",
        pcs: "LVP goes in quickly and holds up to kids and pets, which makes it a common choice for move-in and rental-ready projects.",
        rural: "Farmhouse renovations often mean matching or replacing original wood floors room by room.",
        storms: "After water damage, we pull damaged flooring and check the subfloor before installing new.",
        wooded: "Damp, shaded lots make moisture testing important before installing hardwood over a slab or crawlspace.",
    },
    "garage-floor-coating": {
        newBuild: "New-construction garages are a great candidate for a flake coating once the slab has fully cured.",
        older: "Older garage slabs usually need crack repair and grinding before a coating will bond.",
        rural: "Workshops and outbuildings on rural properties benefit from a coating that resists oil and chemicals.",
        pcs: "A coated garage floor is a visible upgrade buyers notice, which is handy before a PCS sale.",
        storms: "Garages that take on water from wind-driven rain need a coating rated for moisture, not a big-box kit.",
        wooded: "Pine straw and mud tracked in from wooded lots wipe right off a coated floor.",
    },
    "finish-carpentry": {
        older: "In older homes we often replace damaged baseboard and trim and match existing profiles so new pieces blend in.",
        newBuild: "Newer homes often have plain builder trim; crown molding, wainscoting, and built-ins are popular upgrades.",
        pcs: "Quick trim repairs and door adjustments help a home pass inspection before a PCS move.",
        rural: "Farmhouse-style homes suit board-and-batten, shiplap, and custom built-ins.",
        wooded: "Exterior trim on shaded lots rots faster, and we replace it with rot-resistant material where it makes sense.",
        storms: "Storm-damaged exterior trim and door casings are a common repair after severe weather.",
    },
    "fence-installation": {
        rural: "Larger rural lots often need longer fence runs and split-rail or field fencing, not just privacy panels.",
        newBuild: "In newer subdivisions, check HOA fence rules on height, style, and stain color before we start; we'll build to them.",
        storms: "Wind storms snap rotted posts and push panels over; often only a few posts need replacing, not the whole fence.",
        wooded: "Fences under trees stay damp and rot at the base sooner, so post setting and drainage matter more.",
        older: "Older fences often have posts set without enough concrete; we reset or replace them rather than patching boards.",
        pcs: "Repairing a leaning fence or broken gate is a common pre-sale fix.",
    },
    "deck-repair": {
        older: "Older decks need a close look at ledger boards, joists, and railings, not just the surface boards.",
        wooded: "Decks on shaded, wooded lots grow mildew and rot faster; cleaning and sealing on a schedule extends their life.",
        storms: "Falling limbs and storms damage railings and boards; we replace what's damaged and check the framing underneath.",
        newBuild: "Newer decks often just need cleaning and their first proper seal or stain.",
        rural: "Rural homes often have larger decks and porches where staged repairs keep cost manageable.",
        pcs: "Loose railings and soft boards are common home-inspection items before a sale.",
    },
    "pressure-washing": {
        wooded: "Shaded, wooded lots grow mildew and algae on siding, so soft washing is the right approach for most homes here.",
        older: "On older siding and painted surfaces we use low pressure so we don't strip paint or force water behind the siding.",
        newBuild: "Newer homes mostly need driveways, walks, and north-facing siding cleaned of red clay and mildew.",
        rural: "Rural properties often add long driveways, outbuildings, and fencing to the job.",
        pcs: "A house wash before listing photos is one of the cheapest curb-appeal boosts before a PCS sale.",
        storms: "After storms we clear mud and debris from siding, decks, and walks.",
    },
};

const area = areaContext[fullCity];
const localNotes = area.traits
    .map((t) => serviceTraitNotes[service.id]?.[t])
    .filter(Boolean) as string[];

const title = `${service.name} in ${city}, AL`;
const description = `${service.shortDesc} in ${city}, AL. Licensed & insured. Free estimates, fast response. Call (256) 221-0373.`;

// Cannibalization fix: for the four core cities we already have stronger,
// hand-written service hub pages. Point these templated service+city pages'
// canonical at that hub so Google consolidates ranking signals instead of
// splitting them across near-duplicate URLs. The sub-area cities (Harvest,
// Owens Cross Roads, Hampton Cove, Redstone Arsenal) have no hub equivalent,
// so they stay self-canonical.
const serviceHubSlug: Record<string, string> = {
    "drywall-repair": "drywall",
    "interior-painting": "painting",
    "exterior-painting": "exterior-painting",
    "gutter-cleaning": "gutter-cleaning",
    "gutter-installation": "gutter-installation",
    "flooring-installation": "flooring",
    "garage-floor-coating": "garage-floor-coating",
    "finish-carpentry": "finish-carpentry",
    "fence-installation": "fence-installation",
    "deck-repair": "deck-repair",
    "pressure-washing": "pressure-washing",
};
const coreCities = ["madison-al", "huntsville-al", "athens-al", "decatur-al"];
const canonical =
    coreCities.includes(fullCity) && serviceHubSlug[service.id]
        ? `https://www.rittenworxhandyman.net/services/${serviceHubSlug[service.id]}/`
        : undefined;

// Custom local schema for this specific combination
const localSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "LocalBusiness",
            "@id": `https://www.rittenworxhandyman.net/services/${slug}/#business`,
            name: `Rittenworx - ${city}`,
            description: description,
            url: `https://www.rittenworxhandyman.net/services/${slug}`,
            telephone: "(256) 221-0373",
            address: {
                "@type": "PostalAddress",
                addressLocality: city,
                addressRegion: "AL",
            },
            areaServed: [{ "@type": "City", name: city, addressRegion: "AL" }],
        },
        {
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: `How much does ${service.name.toLowerCase()} cost in ${city}, AL?`,
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: `${service.name} pricing in ${city} depends on the scope of work. Rittenworx offers free, no-obligation estimates — call (256) 221-0373 or text a photo of your project. Roy will go over the details with you.`,
                    },
                },
                {
                    "@type": "Question",
                    name: `Is Rittenworx licensed and insured for ${service.name.toLowerCase()} in ${city}?`,
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: `Yes. Rittenworx is a licensed and insured handyman service in ${city}, Alabama. We are a family-owned business with 7 years of experience serving North Alabama homeowners.`,
                    },
                },
                {
                    "@type": "Question",
                    name: `How quickly can Rittenworx schedule ${service.name.toLowerCase()} work in ${city}?`,
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: `Scheduling depends on the job and Roy's current workload. Call or text (256) 221-0373 and Roy will let you know the earliest available opening on his schedule.`,
                    },
                },
                {
                    "@type": "Question",
                    name: `Does Rittenworx offer free estimates for ${service.name.toLowerCase()} near ${city}?`,
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: `Yes — all estimates for ${service.name.toLowerCase()} in ${city} and surrounding North Alabama communities are completely free and carry no obligation. Request yours online or call (256) 221-0373.`,
                    },
                },
            ],
        },
    ],
};
---

<Layout title={title} description={description} schema={localSchema} canonical={canonical}>
    <!-- Premium Hero Section -->
    <section
        class="relative bg-blue-900 text-white pt-32 pb-24 flex items-center overflow-hidden"
    >
        <div class="absolute inset-0 z-0">
            <img
                src="/hero-handyman.webp"
                alt={`${service.name} Services in ${city}`}
                class="w-full h-full object-cover opacity-20 scale-105 animate-[pulse_10s_ease-in-out_infinite_alternate]"
            />
            <div
                class="absolute inset-0 bg-gradient-to-t from-blue-950 via-blue-900/90 to-blue-900/60"
            >
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
            <div class="max-w-3xl">
                <nav
                    class="text-blue-200 text-sm mb-6 flex items-center gap-2 font-medium tracking-wide"
                >
                    <a
                        href="/locations"
                        class="hover:text-white transition-colors">Locations</a
                    >
                    <span class="opacity-50">/</span>
                    <a
                        href={`/locations/${cityPath}`}
                        class="hover:text-white transition-colors">{city}</a
                    >
                    <span class="opacity-50">/</span>
                    <span class="text-orange-400">{service.name}</span>
                </nav>

                <div
                    class="inline-block px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-6 text-sm font-medium text-blue-100"
                >
                    <span
                        class="w-2 h-2 inline-block rounded-full bg-orange-400 mr-2 animate-pulse"
                    ></span>
                    Local {city} Handyman
                </div>

                <h1
                    class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight tracking-tight"
                >
                    {service.name}
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600"
                        >in {city}, AL</span
                    >
                </h1>

                <p
                    class="text-xl md:text-2xl text-blue-100 mb-10 font-light leading-relaxed"
                >
                    {service.shortDesc} tailored specifically for homes in {
                        city
                    }. Fast, reliable, and backed by a commitment to absolute
                    professionalism.
                </p>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        href="sms:2562210373"
                        class="group bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-500/30 hover:shadow-orange-500/50 hover:-translate-y-1 border border-orange-400/30"
                    >
                        <svg
                            class="w-6 h-6 group-hover:scale-110 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                            ></path>
                        </svg>
                        Text A Photo For A Quote
                    </a>
                </div>
            </div>
        </div>

        <!-- Decorative shape divider -->
        <div
            class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-10"
        >
            <svg
                class="relative block w-full h-[50px] md:h-[100px]"
                data-name="Layer 1"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 1200 120"
                preserveAspectRatio="none"
            >
                <path
                    d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.06,155.15,112.5,231.2,88.45,264.44,77.83,296.88,67.36,321.39,56.44Z"
                    class="fill-white"></path>
            </svg>
        </div>
    </section>

    <!-- Main Content -->
    <section class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4">
            <h2
                class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 font-display tracking-tight"
            >
                The {service.name} Contractor {city} Homeowners Actually Call Back
            </h2>
            <p class="text-gray-700 text-lg leading-relaxed mb-6">
                Most {city} homeowners have a bad contractor story. The quote that
                ballooned at invoice time. The crew that showed up three days late.
                The work that looked fine — until it didn't. When you need <strong
                    >{service.name.toLowerCase()}</strong
                > done right, the last thing you want is to roll the dice again.
            </p>
            <p class="text-gray-700 text-lg leading-relaxed mb-6">
                Rittenworx has been doing {service.name.toLowerCase()} work in
                North Alabama for 7 years. We're licensed and insured. We send a
                written estimate you can hold us to — and the final bill matches
                it. That’s how we’ve built every client relationship we have.
                Whether it’s a project you’ve been putting off or something
                that just came up, here’s what actually happens when you reach
                out: we answer, we schedule, we show up on time. The same crew
                you talked to is the crew that does the work — no handoffs to
                subcontractors. We clean up before we leave. And we walk the job
                with you before we consider it done.
            </p>

            <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 mt-14">
                {service.name} in {city}: What We See
            </h3>
            <p class="text-gray-700 text-lg leading-relaxed mb-6">
                {area.intro}
            </p>
            {localNotes.length > 0 && (
                <ul class="list-disc pl-6 space-y-3 text-gray-700 text-lg leading-relaxed mb-6">
                    {localNotes.map((note) => <li>{note}</li>)}
                </ul>
            )}
            {area.link && (
                <p class="text-gray-700 text-lg leading-relaxed mb-6">
                    More about our <a href={area.link.href} class="text-blue-700 underline font-semibold">{area.link.label}</a>.
                </p>
            )}

            <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 mt-14">
                Why {city} Homeowners Choose Rittenworx First
            </h3>
            <p class="text-gray-700 text-lg leading-relaxed mb-6">
                Unlicensed workers are the single biggest source of costly
                redo work in home repair. If something goes wrong on your property
                and the contractor isn't properly insured, that cost lands on you.
                We're licensed and insured, and we can show you the
                certificate before we start.
            </p>
            <p class="text-gray-700 text-lg leading-relaxed mb-10">
                Seven years in Madison County means we know the local construction
                styles, the materials that hold up in North Alabama's climate, and
                the shortcuts that always come back to bite. We use commercial-grade
                materials — not whatever's cheapest at the big-box store — because
                we'd rather do it once than twice.
            </p>

            <div
                class="bg-gradient-to-br from-blue-50 to-white p-8 md:p-10 rounded-3xl border border-blue-100 my-16 shadow-lg shadow-blue-900/5 relative overflow-hidden group hover:border-blue-200 transition-colors"
            >
                <div
                    class="absolute top-0 right-0 w-64 h-64 bg-blue-100 rounded-full blur-[80px] opacity-40 -mr-20 -mt-20 pointer-events-none group-hover:opacity-60 transition-opacity"
                >
                </div>
                <h3 class="text-2xl font-bold text-blue-900 mb-8 relative z-10">
                    What Makes Rittenworx Different in {city}
                </h3>
                <ul class="space-y-6 relative z-10">
