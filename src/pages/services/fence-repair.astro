---
import Layout from "../../layouts/Layout.astro";
import TrustCredentials from "../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../components/InlineQuoteForm.astro";

const serviceAreas = ["Madison", "Huntsville", "Decatur", "Athens"];

const services = [
  {
    id: "posts",
    title: "Post Replacement & Leveling",
    icon: "M12 4v16m0 0H8m4 0h4M6 8h.01M18 8h.01",
    items: [
      "Rotted or storm-snapped wood post replacement",
      "Concrete footing repair and re-setting",
      "Leaning fence line straightening",
      "Metal post repair for chain-link fencing",
      "Post cap replacement",
    ],
    detail:
      "A leaning fence is almost always a post problem, not a panel problem — usually a rotted base or a footing that's shifted. We dig out and reset the post in fresh concrete rather than just bracing it, so the fix actually holds.",
  },
  {
    id: "panels",
    title: "Panel, Picket & Board Repair",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    items: [
      "Broken and missing picket replacement",
      "Storm-damaged panel section repair",
      "Privacy fence board replacement (matched to existing stain)",
      "Chain-link fabric patching and re-tensioning",
      "Split rail repair",
    ],
    detail:
      "Replacement boards get matched to your existing fence style and spacing so the repair blends in rather than standing out as an obvious patch.",
  },
  {
    id: "gates",
    title: "Gate Repair & Realignment",
    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
    items: [
      "Sagging gate realignment and diagonal bracing",
      "Hinge and latch replacement",
      "Self-closing hinge installation for pool/pet safety",
      "New gate frame construction",
      "Automatic gate opener troubleshooting",
    ],
    detail:
      "A sagging gate usually just needs a diagonal turnbuckle brace and new hardware — a much cheaper fix than a full gate rebuild, and one we can usually finish same-visit.",
  },
  {
    id: "install",
    title: "New Fence Installation",
    icon: "M9 3v18m6-18v18M3 9h18M3 15h18",
    items: [
      "Wood privacy and picket fence installation",
      "Vinyl fence installation",
      "Chain-link fencing for yards and side lots",
      "Property line fencing",
      "Pet and pool safety fencing",
    ],
    detail:
      "New installs start with locating your property line and any underground utilities before we dig a single post hole, so there are no surprises — or disputes with the neighbors — after the fact.",
  },
];

const faqs = [
  {
    question: "How much does fence repair cost in Madison or Huntsville, AL?",
    answer:
      "It depends on what's damaged — a single leaning post is a much smaller job than replacing a storm-damaged section of panels. Text a photo of the damage to (256) 221-0373 and we'll give you a straightforward estimate.",
  },
  {
    question: "Can you match my existing fence style and stain color?",
    answer:
      "Yes. We match board spacing, picket style, and post caps to your existing fence, and can color-match stain so replacement boards blend in instead of standing out.",
  },
  {
    question: "Why is my fence leaning even though the boards look fine?",
    answer:
      "It's almost always the posts — either a rotted base below the soil line or a concrete footing that's shifted from years of wet/dry soil cycles. We reset the post in fresh concrete rather than just bracing it against the lean.",
  },
  {
    question: "Do I need a permit to install a new fence in Alabama?",
    answer:
      "It depends on your city and HOA — height limits and setback rules vary by municipality. We can point you to what your city requires when we come out for the estimate.",
  },
  {
    question: "Do you install vinyl fencing, or just wood?",
    answer:
      "Both. Wood privacy and picket fences are the most common request, but we also install vinyl and chain-link. Tell us what you're picturing and we'll walk you through the tradeoffs.",
  },
  {
    question: "How long does a fence repair or new installation take?",
    answer:
      "A post reset or small panel repair is usually a same-day job. A new fence install depends on the linear footage — we'll give you a time estimate along with your quote.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Fence Repair & Installation Madison AL"
  description="Fence repair and installation in Madison, Huntsville, Decatur & Athens, AL. Post replacement, panel repair, gate repair & new fence builds. Free estimates."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-blue-900 text-white pt-32 pb-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-950 via-blue-900 to-blue-800"></div>
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-orange-500/10 rounded-full blur-[120px] -mr-40 -mt-40"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
      <div class="max-w-3xl">
        <nav class="text-blue-200 text-sm mb-6 flex items-center gap-2 font-medium tracking-wide">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="opacity-50">/</span>
          <a href="/services" class="hover:text-white transition-colors">Services</a>
          <span class="opacity-50">/</span>
          <span class="text-orange-400">Fence Repair</span>
        </nav>

        <div class="inline-block px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-6 text-sm font-medium text-blue-100">
          <span class="w-2 h-2 inline-block rounded-full bg-green-400 mr-2 animate-ping"></span>
          Posts, Panels, Gates &amp; New Builds
        </div>

        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight tracking-tight">
          Fence Repair &amp;<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">Installation</span>
        </h1>

        <p class="text-xl md:text-2xl text-blue-100 mb-10 font-light leading-relaxed">
          Leaning posts, storm-damaged panels, sagging gates, or a brand-new fence line. Serving Madison, Huntsville, Decatur, and Athens, AL.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="sms:2562210373"
            class="group bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-500/30 hover:-translate-y-1"
          >
            <svg class="w-6 h-6 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            </svg>
            Text A Photo For A Quote
          </a>
          <a
            href="tel:+12562210373"
            class="group bg-white/10 hover:bg-white/20 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 border border-white/20 hover:-translate-y-1"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call (256) 221-0373
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          {services.map((s) => (
            <span class="px-4 py-2 bg-white/10 rounded-full text-sm text-blue-100 border border-white/10">
              {s.title}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 prose prose-lg prose-blue">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 tracking-tight">
        Usually a Post Problem, Not a Fence Problem
      </h2>
      <p class="text-gray-700 text-lg leading-relaxed mb-6">
        When a fence starts leaning or a gate stops closing, the panels are usually fine — the
        problem is almost always at the post. Wet/dry soil cycles and years of wind load work a
        wood post loose at the base, or rot sets in below the soil line where you can't see it.
        Bracing the lean without fixing the post just buys a season or two before it's back.
      </p>
      <p class="text-gray-700 text-lg leading-relaxed">
        We diagnose the real problem before we start — is it one post, a whole section after a
        storm, or is the fence at the end of its life and worth rebuilding — and give you a
        straightforward recommendation, not just a quote for whatever's easiest for us.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">What We Handle</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Repair or Rebuild, Any Fence Type</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {services.map((s) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon}></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-3">{s.title}</h3>
            <ul class="space-y-1.5 mb-4">
              {s.items.map((item) => (
                <li class="text-gray-600 text-sm flex items-start gap-2">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="text-gray-500 text-sm border-t border-gray-100 pt-3">{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link callout -->
  <section class="py-14 bg-blue-900 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-3">Fence Looking Weathered, Not Broken?</h2>
      <p class="text-blue-100 mb-6 max-w-2xl mx-auto">
        A structurally sound fence that just looks gray and dirty doesn't need a rebuild — it needs
        a wash and a fresh coat of stain.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/services/pressure-washing" class="bg-white text-blue-900 font-bold py-3 px-6 rounded-lg hover:bg-blue-50 transition-colors">Pressure Washing</a>
        <a href="/services/painting" class="bg-white/10 border border-white/30 font-bold py-3 px-6 rounded-lg hover:bg-white/20 transition-colors">Staining &amp; Painting</a>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">Common Questions</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Fence Repair &amp; Installation FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bg-white rounded-lg shadow-sm group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-800 hover:text-blue-900 flex items-center justify-between">
              {faq.question}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-600">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">The Rittenworx Difference</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Why North Alabama Homeowners Choose Us</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">We Fix the Real Problem</h3>
          <p class="text-gray-600 text-sm">We reset failing posts in fresh concrete instead of bracing a lean, so the repair actually holds.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">Licensed &amp; Insured</h3>
          <p class="text-gray-600 text-sm">Covered on every job, from a single post reset to a full property-line fence installation.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">We Answer the Phone</h3>
          <p class="text-gray-600 text-sm">Text a photo of your fence and get a straightforward answer — no phone tag, no unreturned calls.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">Coverage Area</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Fence Repair &amp; Installation Service Areas</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
        {serviceAreas.map((area) => (
          <a
            href={`/locations/${area.toLowerCase()}`}
            class="block group rounded-2xl p-6 text-center bg-white border border-gray-100 shadow-lg hover:shadow-xl hover:border-blue-100 hover:-translate-y-1 transition-all duration-300"
          >
            <h3 class="text-xl font-bold mb-2 text-gray-900 group-hover:text-blue-900">{area}, AL</h3>
            <div class="inline-flex items-center gap-2 text-sm font-bold text-blue-600">
              View Details
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <InlineQuoteForm />

  <TrustCredentials />

  <!-- CTA -->
  <section class="py-16 bg-orange-500 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Fix or Build Your Fence?</h2>
      <p class="text-xl mb-8">Contact us today for a free fence repair or installation estimate.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="bg-white hover:bg-gray-100 text-orange-500 font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block">Get Free Estimate</a>
        <a href="tel:2562210373" class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block">(256) 221-0373</a>
      </div>
    </div>
  </section>
</Layout>
