---
import Layout from "../../layouts/Layout.astro";
import TrustCredentials from "../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../components/InlineQuoteForm.astro";

const serviceAreas = ["Madison", "Huntsville", "Decatur", "Athens"];

const services = [
  {
    id: "siding",
    title: "House Siding & Exterior Wash",
    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
    items: [
      "Vinyl, brick, Hardie board & fiber-cement siding wash",
      "Mildew, algae, and pollen film removal",
      "Soft-wash technique for painted or older siding",
      "Soffit and fascia brightening",
      "Window and door trim cleaning",
      "Spot treatment for rust and organic staining",
    ],
    detail:
      "North Alabama's humidity keeps mildew and algae coming back on siding, especially on shaded north-facing walls. We use a soft-wash approach (low pressure, the right cleaning solution) on siding and paint so we clean the growth off without stripping paint or driving water behind the panels.",
  },
  {
    id: "concrete",
    title: "Driveway, Walkway & Patio Cleaning",
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
    items: [
      "Concrete driveway and sidewalk cleaning",
      "Oil stain and tire mark treatment",
      "Paver patio and pool deck washing",
      "Rust stain removal from sprinkler heads and furniture",
      "Garage floor cleaning ahead of an epoxy coating",
      "Front porch and entryway cleaning",
    ],
    detail:
      "Concrete can handle real pressure, so this is where a surface cleaner attachment earns its keep — even coverage with no streaking or zebra-striping. If you're planning a garage epoxy coating, a proper pressure wash is the first step of surface prep either way.",
  },
  {
    id: "wood",
    title: "Deck, Fence & Wood Surface Washing",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    items: [
      "Pressure-treated deck cleaning before staining or sealing",
      "Wood and vinyl fence washing",
      "Gray, weathered wood restoration wash",
      "Mildew and green algae removal from shaded decking",
      "Pergola and outdoor structure cleaning",
      "Pre-stain surface prep",
    ],
    detail:
      "Wood needs a gentler touch than concrete — too much pressure raises the grain and leaves the surface fuzzy and hard to stain evenly. We dial the PSI down for decking and fencing, and this is the right first step before any staining or sealing project.",
  },
  {
    id: "roof",
    title: "Roof Soft Washing",
    icon: "M3 12l9-9 9 9M4 10v10a1 1 0 001 1h4a1 1 0 001-1v-6a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 001 1h4a1 1 0 001-1V10",
    items: [
      "Black streak (algae) removal from asphalt shingles",
      "Low-pressure soft wash — no shingle damage",
      "Moss and lichen treatment",
      "Gutter exterior brightening while we're up there",
    ],
    detail:
      "Roof streaking is algae, not dirt, and high-pressure washing a roof can void your shingle warranty and knock granules loose. Roof cleaning is always a soft wash — low pressure, the right treatment, and the streaks come off without damaging the shingles.",
  },
];

const faqs = [
  {
    question: "How much does pressure washing cost in Madison or Huntsville, AL?",
    answer:
      "It depends on the surface and square footage — a driveway is priced differently than a full house wash or a roof soft-wash. Text a photo and the approximate size and we'll get you a number, or request a free on-site estimate.",
  },
  {
    question: "What's the difference between pressure washing and soft washing?",
    answer:
      "Pressure washing uses high PSI water pressure alone and is right for concrete, brick, and other hard surfaces. Soft washing uses lower pressure combined with a cleaning solution to kill mildew and algae at the root — it's what we use on siding, paint, and roofs, where high pressure could cause damage.",
  },
  {
    question: "Will pressure washing damage my siding or deck?",
    answer:
      "Not when it's done at the right pressure for the surface. We adjust PSI and nozzle angle by material — concrete can take a lot more pressure than vinyl siding or wood decking. This is the most common way DIY pressure washing goes wrong, and it's the main reason to hire it out.",
  },
  {
    question: "How often should I get my house pressure washed?",
    answer:
      "Most North Alabama homes benefit from an annual wash — once a year keeps mildew and pollen film from building up. Shaded, humid lots may need it every 6-9 months. Concrete and decks generally need it whenever you're prepping for a paint or stain job, plus a yearly refresh.",
  },
  {
    question: "Do you pressure wash before exterior painting?",
    answer:
      "Yes — it's the first step of proper paint prep. Paint won't adhere to a chalky, dirty, or mildewed surface, so we wash before priming on every exterior painting job. See our exterior painting page for the full process.",
  },
  {
    question: "Is pressure washing safe for my roof?",
    answer:
      "High-pressure washing isn't — it can strip granules and void a shingle warranty. We soft-wash roofs instead: low pressure plus the right cleaning solution to remove algae streaks without damaging the shingles.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Pressure Washing Madison AL | House, Driveway & Deck"
  description="Pressure & soft washing in Madison, Huntsville, Decatur & Athens, AL. Siding, driveways, decks, fences & roof soft-washing. Licensed & insured. Free estimates."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-blue-900 text-white pt-32 pb-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-950 via-blue-900 to-blue-800"></div>
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-orange-500/10 rounded-full blur-[120px] -mr-40 -mt-40"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
      <div class="max-w-3xl">
        <nav class="text-blue-200 text-sm mb-6 flex items-center gap-2 font-medium tracking-wide">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="opacity-50">/</span>
          <a href="/services" class="hover:text-white transition-colors">Services</a>
          <span class="opacity-50">/</span>
          <span class="text-orange-400">Pressure Washing</span>
        </nav>

        <div class="inline-block px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-6 text-sm font-medium text-blue-100">
          <span class="w-2 h-2 inline-block rounded-full bg-green-400 mr-2 animate-ping"></span>
          Right Pressure For Every Surface
        </div>

        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight tracking-tight">
          Pressure &amp; Soft<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">Washing</span>
        </h1>

        <p class="text-xl md:text-2xl text-blue-100 mb-10 font-light leading-relaxed">
          Siding, driveways, decks, fences, and roofs — cleaned at the right pressure for the surface. Serving Madison, Huntsville, Decatur, and Athens, AL.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="sms:2562210373"
            class="group bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-500/30 hover:-translate-y-1"
          >
            <svg class="w-6 h-6 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            </svg>
            Text A Photo For A Quote
          </a>
          <a
            href="tel:+12562210373"
            class="group bg-white/10 hover:bg-white/20 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 border border-white/20 hover:-translate-y-1"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call (256) 221-0373
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          {services.map((s) => (
            <span class="px-4 py-2 bg-white/10 rounded-full text-sm text-blue-100 border border-white/10">
              {s.title}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 prose prose-lg prose-blue">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 tracking-tight">
        Why Surface Matters More Than Power
      </h2>
      <p class="text-gray-700 text-lg leading-relaxed mb-6">
        Most DIY pressure washing goes wrong for one reason: the same PSI setting gets pointed at
        everything. Concrete can take a serious blast. Vinyl siding, painted wood trim, and asphalt
        shingles cannot — too much pressure drives water behind siding panels, strips paint, gouges
        wood, and knocks granules off a roof. We match the pressure, nozzle, and cleaning solution to
        the surface, so the mildew and grime come off without taking the surface with it.
      </p>
      <p class="text-gray-700 text-lg leading-relaxed">
        North Alabama's humidity means algae and mildew come back fast, especially on shaded
        north-facing walls and roof lines. A yearly wash keeps ahead of it — and it's also the
        required first step before any exterior paint, stain, or garage epoxy project.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">What We Clean</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Every Exterior Surface</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {services.map((s) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon}></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-3">{s.title}</h3>
            <ul class="space-y-1.5 mb-4">
              {s.items.map((item) => (
                <li class="text-gray-600 text-sm flex items-start gap-2">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="text-gray-500 text-sm border-t border-gray-100 pt-3">{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link callout -->
  <section class="py-14 bg-blue-900 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-3">Planning a Paint Job or Deck Refresh?</h2>
      <p class="text-blue-100 mb-6 max-w-2xl mx-auto">
        A proper wash is the first step of prep for exterior painting and deck staining. We can wash
        and finish the whole project so you're not coordinating two contractors.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/services/exterior-painting" class="bg-white text-blue-900 font-bold py-3 px-6 rounded-lg hover:bg-blue-50 transition-colors">Exterior Painting</a>
        <a href="/blog/spring-deck-and-exterior-trim-repair-guide-madison-al" class="bg-white/10 border border-white/30 font-bold py-3 px-6 rounded-lg hover:bg-white/20 transition-colors">Deck &amp; Trim Repair Guide</a>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">Common Questions</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Pressure Washing FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bg-white rounded-lg shadow-sm group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-800 hover:text-blue-900 flex items-center justify-between">
              {faq.question}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-600">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">The Rittenworx Difference</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Why North Alabama Homeowners Choose Us</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">Right Pressure, Every Time</h3>
          <p class="text-gray-600 text-sm">Concrete gets full pressure. Siding, wood, and roofs get a gentler soft wash. No damaged paint, no gouged decking.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">Licensed &amp; Insured</h3>
          <p class="text-gray-600 text-sm">Covered on every job, no matter the size — one wash or a full-property clean before you list your home.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">One Contractor, Not Three</h3>
          <p class="text-gray-600 text-sm">We wash, we paint, we stain, we coat. Book the whole exterior refresh with the crew you already trust.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">Coverage Area</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Pressure Washing Service Areas</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
        {serviceAreas.map((area) => (
          <a
            href={`/locations/${area.toLowerCase()}`}
            class="block group rounded-2xl p-6 text-center bg-white border border-gray-100 shadow-lg hover:shadow-xl hover:border-blue-100 hover:-translate-y-1 transition-all duration-300"
          >
            <h3 class="text-xl font-bold mb-2 text-gray-900 group-hover:text-blue-900">{area}, AL</h3>
            <div class="inline-flex items-center gap-2 text-sm font-bold text-blue-600">
              View Details
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <InlineQuoteForm />

  <TrustCredentials />

  <!-- CTA -->
  <section class="py-16 bg-orange-500 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready for a Cleaner Exterior?</h2>
      <p class="text-xl mb-8">Contact us today for a free pressure washing estimate.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="bg-white hover:bg-gray-100 text-orange-500 font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block">Get Free Estimate</a>
        <a href="tel:2562210373" class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block">(256) 221-0373</a>
      </div>
    </div>
  </section>
</Layout>
