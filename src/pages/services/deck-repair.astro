---
import Layout from "../../layouts/Layout.astro";
import TrustCredentials from "../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../components/InlineQuoteForm.astro";

const serviceAreas = ["Madison", "Huntsville", "Decatur", "Athens"];

const services = [
  {
    id: "structural",
    title: "Structural Inspection & Repair",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    items: [
      "Ledger board and house connection inspection",
      "Joist and beam rot assessment",
      "Post and footing stability check",
      "Loose or missing joist hanger repair",
      "Bounce/sway diagnosis and bracing",
    ],
    detail:
      "The ledger board — where the deck attaches to your house — is the single most important connection to get right, and the one most often installed wrong on older decks. We check it first on every inspection, because that's the failure point that actually hurts someone.",
  },
  {
    id: "boards",
    title: "Board & Railing Replacement",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    items: [
      "Rotted or splintered decking board replacement",
      "Composite decking repair (Trex, TimberTech, etc.)",
      "Guardrail and baluster repair — code-spacing check",
      "Loose railing post reinforcement",
      "Stair tread and stringer repair",
    ],
    detail:
      "Railings get checked against code spacing (no gap wider than 4 inches) while we're out there, not just for looseness — it's the difference between a repair and a liability waiting to happen.",
  },
  {
    id: "finishing",
    title: "Deck Staining & Sealing",
    icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M8 12l4 4",
    items: [
      "Pressure washing before staining or sealing",
      "Solid, semi-transparent, and clear sealant options",
      "Sanding and prep on weathered wood",
      "Composite deck cleaning and brightening",
      "Annual maintenance and re-sealing",
    ],
    detail:
      "Alabama sun and humidity break down deck sealant faster than most homeowners expect — a deck that isn't refinished every 1-3 years starts graying, cracking, and letting water into the wood grain.",
  },
];

const faqs = [
  {
    question: "How much does deck repair cost in Madison or Huntsville, AL?",
    answer:
      "It depends on scope — a handful of rotted boards is a much smaller job than a structural ledger board or post repair. Text a photo of the problem area to (256) 221-0373 and we'll get you a straightforward estimate.",
  },
  {
    question: "How do I know if my deck is actually unsafe?",
    answer:
      "Warning signs include noticeable bounce or sway when you walk on it, wood that's soft or spongy when you push a screwdriver into it, rust streaks around fasteners, and railings that wiggle. If you see any of these, get it inspected before you use it for a gathering.",
  },
  {
    question: "How often should a deck be re-stained or sealed?",
    answer:
      "Most pressure-treated decks in North Alabama need re-staining every 1-3 years, depending on sun exposure and the type of sealant used. A deck that's graying, feels dry, or no longer beads water when you splash it needs attention.",
  },
  {
    question: "Can you repair a composite deck, or just wood?",
    answer:
      "Both. Composite decking (Trex, TimberTech, and similar) rarely rots but the substructure underneath is usually still wood, and that's where problems show up first. We inspect and repair both the composite surface and the wood frame beneath it.",
  },
  {
    question: "Is my deck railing up to code?",
    answer:
      "Most residential code requires guardrails on decks more than 30 inches off the ground, with balusters spaced no more than 4 inches apart so a small child can't fit through. We check spacing and post security as part of every inspection.",
  },
  {
    question: "Do you build new decks, or only repair existing ones?",
    answer:
      "We focus on repair, staining, and maintenance of existing decks. If yours is beyond repair, we can talk through your options and point you in the right direction.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Deck Repair & Staining Madison AL"
  description="Deck repair and staining in Madison, Huntsville, Decatur & Athens, AL. Structural repair, board & railing replacement, sealing. Licensed & insured. Free estimates."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-blue-900 text-white pt-32 pb-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-950 via-blue-900 to-blue-800"></div>
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-orange-500/10 rounded-full blur-[120px] -mr-40 -mt-40"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
      <div class="max-w-3xl">
        <nav class="text-blue-200 text-sm mb-6 flex items-center gap-2 font-medium tracking-wide">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="opacity-50">/</span>
          <a href="/services" class="hover:text-white transition-colors">Services</a>
          <span class="opacity-50">/</span>
          <span class="text-orange-400">Deck Repair</span>
        </nav>

        <div class="inline-block px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-6 text-sm font-medium text-blue-100">
          <span class="w-2 h-2 inline-block rounded-full bg-green-400 mr-2 animate-ping"></span>
          Structural Repair &amp; Refinishing
        </div>

        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight tracking-tight">
          Deck Repair &amp;<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">Staining</span>
        </h1>

        <p class="text-xl md:text-2xl text-blue-100 mb-10 font-light leading-relaxed">
          Rotted boards, wobbly railings, structural concerns, or just a tired-looking deck that needs new stain. Serving Madison, Huntsville, Decatur, and Athens, AL.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="sms:2562210373"
            class="group bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-500/30 hover:-translate-y-1"
          >
            <svg class="w-6 h-6 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            </svg>
            Text A Photo For A Quote
          </a>
          <a
            href="tel:+12562210373"
            class="group bg-white/10 hover:bg-white/20 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 border border-white/20 hover:-translate-y-1"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call (256) 221-0373
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          {services.map((s) => (
            <span class="px-4 py-2 bg-white/10 rounded-full text-sm text-blue-100 border border-white/10">
              {s.title}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 prose prose-lg prose-blue">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 tracking-tight">
        Cosmetic Fix or Structural Repair? We Tell You Which.
      </h2>
      <p class="text-gray-700 text-lg leading-relaxed mb-6">
        Not every deck problem needs the same fix. A deck that's gray and dry but solid underfoot
        needs a wash and new stain. A deck with a soft board, a wobbly railing post, or bounce when
        you walk on it needs a structural repair before it needs anything cosmetic. We inspect first
        and tell you honestly which one you're dealing with — most homeowners can't tell the
        difference from the surface, and it's the difference between a $200 fix and a safety issue.
      </p>
      <p class="text-gray-700 text-lg leading-relaxed">
        North Alabama's freeze-thaw winters and humid summers are hard on exterior wood. Spring is
        the best time to catch what winter did before the season's first cookout.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">What We Handle</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">From a Loose Board to a Full Refinish</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {services.map((s) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon}></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-3">{s.title}</h3>
            <ul class="space-y-1.5 mb-4">
              {s.items.map((item) => (
                <li class="text-gray-600 text-sm flex items-start gap-2">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="text-gray-500 text-sm border-t border-gray-100 pt-3">{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link callout -->
  <section class="py-14 bg-blue-900 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-3">Want the Full Spring Deck Checklist?</h2>
      <p class="text-blue-100 mb-6 max-w-2xl mx-auto">
        We wrote up exactly what to inspect on your deck and exterior trim after a North Alabama
        winter — and how a wash before staining changes the outcome.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/blog/spring-deck-and-exterior-trim-repair-guide-madison-al" class="bg-white text-blue-900 font-bold py-3 px-6 rounded-lg hover:bg-blue-50 transition-colors">Read the Deck Inspection Guide</a>
        <a href="/services/pressure-washing" class="bg-white/10 border border-white/30 font-bold py-3 px-6 rounded-lg hover:bg-white/20 transition-colors">Pressure Washing</a>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">Common Questions</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Deck Repair &amp; Staining FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bg-white rounded-lg shadow-sm group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-800 hover:text-blue-900 flex items-center justify-between">
              {faq.question}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-600">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">The Rittenworx Difference</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Why North Alabama Homeowners Choose Us</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">We Check Structure First</h3>
          <p class="text-gray-600 text-sm">Ledger board, joists, and posts get inspected before we ever talk about stain color.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">Licensed &amp; Insured</h3>
          <p class="text-gray-600 text-sm">Covered on every job — from a single railing repair to a full structural fix.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-800">Local to North Alabama</h3>
          <p class="text-gray-600 text-sm">We know how our freeze-thaw winters and humid summers wear down exterior wood — and how to build for it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-orange-700 font-semibold text-sm uppercase tracking-wide">Coverage Area</span>
        <h2 class="text-3xl font-bold text-gray-800 mt-2">Deck Repair Service Areas</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
        {serviceAreas.map((area) => (
          <a
            href={`/locations/${area.toLowerCase()}`}
            class="block group rounded-2xl p-6 text-center bg-white border border-gray-100 shadow-lg hover:shadow-xl hover:border-blue-100 hover:-translate-y-1 transition-all duration-300"
          >
            <h3 class="text-xl font-bold mb-2 text-gray-900 group-hover:text-blue-900">{area}, AL</h3>
            <div class="inline-flex items-center gap-2 text-sm font-bold text-blue-600">
              View Details
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <InlineQuoteForm />

  <TrustCredentials />

  <!-- CTA -->
  <section class="py-16 bg-orange-500 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Fix or Refinish Your Deck?</h2>
      <p class="text-xl mb-8">Contact us today for a free deck repair or staining estimate.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="bg-white hover:bg-gray-100 text-orange-500 font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block">Get Free Estimate</a>
        <a href="tel:2562210373" class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block">(256) 221-0373</a>
      </div>
    </div>
  </section>
</Layout>
