---
import Layout from "../../layouts/Layout.astro";
import TrustCredentials from "../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../components/InlineQuoteForm.astro";

const serviceAreas = ["Madison", "Huntsville", "Decatur", "Athens", "Harvest"];

const fenceTypes = [
  {
    name: "Wood Privacy Fence",
    description:
      "Solid board-on-board or shadowbox panels for backyards, pools, and anywhere you want full privacy from the neighbors.",
    benefits: [
      "6-ft or 8-ft height options",
      "Cedar or pressure-treated pine",
      "Blocks sightlines completely",
      "Stains or paints well",
    ],
    bestFor: "Backyards, pools, patios",
  },
  {
    name: "Wood Picket Fence",
    description:
      "The classic front-yard fence — decorative, low, and built to mark a property line without walling off the view.",
    benefits: [
      "Curb appeal upgrade",
      "3-ft to 4-ft typical height",
      "Custom picket spacing",
      "Gate options for walkways",
    ],
    bestFor: "Front yards, garden borders",
  },
  {
    name: "Split-Rail Fence",
    description:
      "Simple post-and-rail construction for marking a large property line without blocking the view.",
    benefits: [
      "Low material cost",
      "Fast to install per linear foot",
      "Rural / farmhouse look",
      "Easy to extend later",
    ],
    bestFor: "Large lots, acreage, rural properties",
  },
  {
    name: "Fence Repair",
    description:
      "Post replacement, panel repair, and gate fixes for an existing fence that's leaning, rotting, or won't latch anymore.",
    benefits: [
      "Individual post replacement",
      "Panel and picket swaps",
      "Gate re-hanging and hardware",
      "Often cheaper than a full rebuild",
    ],
    bestFor: "Storm damage, rot, sagging gates",
  },
];

const installProcess = [
  {
    step: "1",
    title: "Walk the Line",
    description:
      "Roy walks the fence line with you, talks through height, material, and gate placement.",
  },
  {
    step: "2",
    title: "Check the Property Line",
    description:
      "Before anything gets dug, we confirm your property line and any HOA rules so there are no surprises later.",
  },
  {
    step: "3",
    title: "Written Quote",
    description:
      "You get a real number based on linear footage and material — not a verbal guess.",
  },
  {
    step: "4",
    title: "Post Layout & Digging",
    description:
      "Posts are spaced and set to plan, typically 6 to 8 feet apart depending on the fence style.",
  },
  {
    step: "5",
    title: "Setting Posts in Concrete",
    description:
      "Each post is set plumb in concrete footings for a fence that stays straight for years, not months.",
  },
  {
    step: "6",
    title: "Panels, Pickets & Gates",
    description:
      "Rails, panels, and gates go up level and square, with hardware that actually holds up.",
  },
  {
    step: "7",
    title: "Final Walkthrough",
    description:
      "We check every gate swings and latches right before we call the job done.",
  },
];

const signsCTA = [
  "Posts leaning or wobbling at the base",
  "Visible rot at the bottom of posts or pickets",
  "Gate won't latch or is dragging on the ground",
  "Sections down after a storm",
  "Fence doesn't match a new addition or landscaping",
  "You're selling and need the fence line cleaned up",
];

const faqs = [
  {
    question: "How much does fence installation cost in North Alabama?",
    answer:
      "Cost depends on fence style, height, material, and total linear footage. A split-rail fence runs less per foot than a tall wood privacy fence. We give you a written quote after walking the property, so you know the exact number before work starts.",
  },
  {
    question: "Cedar or pressure-treated pine — which is better?",
    answer:
      "Pressure-treated pine costs less and holds up fine if it's stained or sealed every few years. Cedar costs more up front but naturally resists rot and insects, and ages to a nicer silver-gray if left unfinished. Roy can walk you through the tradeoff for your budget.",
  },
  {
    question: "Do I need to know my property line before you start?",
    answer:
      "Yes — we'll confirm the line with you before digging any post holes. If you have a survey or plat map, that speeds things up. If not, we'll help you figure out the right starting point so the fence doesn't end up on a neighbor's property.",
  },
  {
    question: "Does my HOA or the city require a permit for a fence?",
    answer:
      "Some North Alabama subdivisions have HOA rules on fence height, material, or style, and some cities require a permit for taller fences. We'll flag this during the estimate so you're not caught off guard.",
  },
  {
    question: "Can you repair just a section instead of replacing the whole fence?",
    answer:
      "Often, yes. If the rot or damage is limited to a few posts or panels, repairing that section is usually cheaper and faster than a full rebuild. We'll tell you honestly when repair makes sense and when it doesn't.",
  },
  {
    question: "How long does fence installation take?",
    answer:
      "A typical backyard fence takes one to a few days depending on total footage, ground conditions, and weather. Concrete footings need time to cure before gates are hung, which we build into the schedule.",
  },
  {
    question: "What's included in the quote?",
    answer:
      "Materials, post-hole digging, concrete footings, panel or picket installation, gates and hardware, and cleanup. We tell you the full scope up front — no add-on surprises on the invoice.",
  },
];
---

<Layout
  title="Fence Installation & Repair Madison AL | Rittenworx"
  description="Wood fence installation and repair in Madison, Huntsville, Decatur & Athens, AL. Privacy, picket & split-rail fencing, plus post and gate repair. Free estimates."
>
  <!-- Hero -->
  <section
    class="relative bg-blue-900 text-white pt-32 pb-24 flex items-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/gallery/new-fence.webp"
        alt="Custom wood fence installed by Rittenworx"
        class="w-full h-full object-cover opacity-20 scale-105 animate-[pulse_10s_ease-in-out_infinite_alternate]"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-blue-950 via-blue-900/90 to-blue-900/60"
      >
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
      <div class="max-w-3xl">
        <nav
          class="text-blue-200 text-sm mb-6 flex items-center gap-2 font-medium tracking-wide"
        >
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="opacity-50">/</span>
          <a href="/services" class="hover:text-white transition-colors"
            >Services</a
          >
          <span class="opacity-50">/</span>
          <span class="text-orange-400">Fence Installation</span>
        </nav>

        <div
          class="inline-block px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-6 text-sm font-medium text-blue-100"
        >
          <span
            class="w-2 h-2 inline-block rounded-full bg-orange-400 mr-2 animate-pulse"
          ></span>
          Wood Fence Installation & Repair
        </div>

        <h1
          class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight tracking-tight"
        >
          Fence <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600"
            >Installation & Repair</span
          >
        </h1>

        <p
          class="text-xl md:text-2xl text-blue-100 mb-10 font-light leading-relaxed"
        >
          Privacy, picket, and split-rail fencing built post by post, plus
          repairs for the fence you've already got. One person, start to
          finish.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="sms:2562210373"
            class="group bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 text-lg flex items-center justify-center gap-3 shadow-lg shadow-orange-500/30 hover:shadow-orange-500/50 hover:-translate-y-1 border border-orange-400/30"
          >
            <svg
              class="w-6 h-6 group-hover:scale-110 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
              ></path>
            </svg>
            Text A Photo For A Quote
          </a>
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-10"
    >
      <svg
        class="relative block w-full h-[50px] md:h-[100px]"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
      >
        <path
          d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.06,155.15,112.5,231.2,88.45,264.44,77.83,296.88,67.36,321.39,56.44Z"
          class="fill-white"></path>
      </svg>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 prose prose-lg prose-blue">
      <h2
        class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 font-display tracking-tight"
      >
        A Fence Set in Concrete, Not Guesswork
      </h2>
      <p class="text-gray-700 text-lg leading-relaxed mb-6">
        A fence is only as good as its posts. Roy sets every post plumb, in a
        concrete footing, spaced to hold the panel or rail style you chose —
        the same approach whether it's a full privacy fence around a new pool
        or a short picket fence along the front walk. If you already have a
        fence that's leaning or rotting at the base, that's almost always a
        post problem, and it's often fixable without tearing out the whole
        thing.
      </p>
      <p class="text-gray-700 text-lg leading-relaxed">
        Rittenworx handles both new installation and repair across Madison,
        Huntsville, Decatur, and Athens. Roy does the layout, the digging, and
        the build himself — no subcontracted crew, no surprises on the
        invoice.
      </p>
    </div>
  </section>

  <!-- Signs / why -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span
            class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
            >Time for a Repair?</span
          >
          <h2 class="text-3xl font-bold text-gray-800 mt-2 mb-6">
            Signs Your Fence Needs Attention
          </h2>
          <ul class="space-y-3">
            {
              signsCTA.map((sign) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                    />
                  </svg>
                  <span class="text-gray-700">{sign}</span>
                </li>
              ))
            }
          </ul>
          <a
            href="/contact"
            class="mt-6 inline-block bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg transition-colors"
          >
            Schedule Free Estimate
          </a>
        </div>
        <div class="rounded-lg overflow-hidden shadow-lg">
          <img
            src="/images/gallery/new-fence.webp"
            alt="Custom fence installation project"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Fence types -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span
          class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
          >Options</span
        >
        <h2 class="text-3xl font-bold text-gray-800 mt-2">
          Fence Styles We Build & Repair
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {
          fenceTypes.map((fence) => (
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <h3 class="text-xl font-bold text-blue-900 mb-2">
                {fence.name}
              </h3>
              <p class="text-gray-600 mb-4">{fence.description}</p>
              <ul class="space-y-2 mb-4">
                {fence.benefits.map((benefit) => (
                  <li class="flex items-center gap-2 text-gray-700 text-sm">
                    <svg
                      class="w-4 h-4 text-green-500 flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    {benefit}
                  </li>
                ))}
              </ul>
              <p class="text-sm text-blue-900 font-medium">
                <span class="text-gray-500">Best for:</span> {fence.bestFor}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span
          class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
          >Our Process</span
        >
        <h2 class="text-3xl font-bold text-gray-800 mt-2">
          From Walk-Through to Finished Gate
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          installProcess.map((item) => (
            <div class="bg-gray-50 rounded-lg p-6 text-center shadow-sm">
              <div class="w-12 h-12 bg-blue-900 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">
                {item.step}
              </div>
              <h3 class="font-bold text-gray-800 mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <span
          class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
          >Common Questions</span
        >
        <h2 class="text-3xl font-bold text-gray-800 mt-2">
          Fence Installation & Repair FAQs
        </h2>
      </div>
      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <details class="bg-white rounded-lg shadow-sm group">
              <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-800 hover:text-blue-900 flex items-center justify-between">
                {faq.question}
                <svg
                  class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </summary>
              <div class="px-6 pb-4 text-gray-600">{faq.answer}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="bg-blue-50 rounded-lg p-6">
        <div class="flex items-start gap-4">
          <svg
            class="w-8 h-8 text-blue-900 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            ></path>
          </svg>
          <div>
            <h3 class="text-lg font-bold text-blue-900 mb-2">
              Our Commitment to North Alabama Homeowners
            </h3>
            <p class="text-gray-600 text-sm">
              We're not a big-box installer or a subcontracted crew. Roy is
              your neighbor in Madison County, and he's the one on-site from
              the first post hole to the last gate hinge. Licensed and
              insured, family owned, 7 years serving North Alabama.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span
          class="text-orange-700 font-semibold text-sm uppercase tracking-wide"
          >Coverage Area</span
        >
        <h2 class="text-3xl font-bold text-gray-800 mt-2">
          Fence Installation Service Areas
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        {
          serviceAreas.map((area) => {
            const citySlug = area.toLowerCase().replace(/ /g, "-");
            const finalSlug = `fence-installation-${citySlug}-al`;

            return (
              <a
                href={`/services/${finalSlug}`}
                class={`block group rounded-2xl p-6 text-center transition-all duration-300 ${area === "Madison" ? "bg-gradient-to-br from-blue-900 to-blue-800 text-white shadow-xl shadow-blue-900/20 hover:-translate-y-1" : "bg-white border border-gray-100 shadow-lg hover:shadow-xl hover:border-blue-100 hover:-translate-y-1"}`}
              >
                <h3
                  class={`text-xl font-bold mb-2 ${area === "Madison" ? "text-white" : "text-gray-900 group-hover:text-blue-900"}`}
                >
                  {area}
                </h3>
                <p
                  class={`text-sm mb-4 ${area === "Madison" ? "text-blue-100" : "text-gray-500"}`}
                >
                  Professional Service
                </p>
                <div
                  class={`inline-flex items-center gap-2 text-sm font-bold ${area === "Madison" ? "text-orange-400" : "text-blue-600"}`}
                >
                  View Details
                  <svg
                    class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <InlineQuoteForm />

  <TrustCredentials />

  <!-- CTA -->
  <section class="py-16 bg-orange-500 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Fence It In?</h2>
      <p class="text-xl mb-8">
        Get a free on-site estimate for fence installation or repair.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="bg-white hover:bg-gray-100 text-orange-500 font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block"
        >
          Get Free Estimate
        </a>
        <a
          href="tel:2562210373"
          class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-8 rounded-lg transition-colors text-lg inline-block"
        >
          (256) 221-0373
        </a>
      </div>
    </div>
  </section>

  <!-- Service Area cross-links -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">Service Areas</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-3 mb-4">Fence Installation Across North Alabama</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Rittenworx builds and repairs fences throughout the Tennessee Valley. Pick your city below for local details and response times.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/locations/madison" class="block bg-white rounded-xl p-5 shadow-sm hover:shadow-lg border border-gray-100 hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Madison, AL</h3>
          <p class="text-sm text-gray-600 mt-1">Fence Installation in Madison &amp; Harvest</p>
        </a>
        <a href="/locations/huntsville" class="block bg-white rounded-xl p-5 shadow-sm hover:shadow-lg border border-gray-100 hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Huntsville, AL</h3>
          <p class="text-sm text-gray-600 mt-1">Fence Installation in Huntsville &amp; Hampton Cove</p>
        </a>
        <a href="/locations/decatur" class="block bg-white rounded-xl p-5 shadow-sm hover:shadow-lg border border-gray-100 hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Decatur, AL</h3>
          <p class="text-sm text-gray-600 mt-1">Fence Installation in Decatur &amp; Somerville</p>
        </a>
        <a href="/locations/athens" class="block bg-white rounded-xl p-5 shadow-sm hover:shadow-lg border border-gray-100 hover:-translate-y-1 transition-all">
          <h3 class="font-bold text-gray-900">Athens, AL</h3>
          <p class="text-sm text-gray-600 mt-1">Fence Installation across Limestone County</p>
        </a>
      </div>
    </div>
  </section>

</Layout>
