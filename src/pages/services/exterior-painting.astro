  </section>

  <!-- Trust Bar -->
  <section class="bg-white py-4 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm font-medium text-gray-700">
        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Licensed & Insured</span>
