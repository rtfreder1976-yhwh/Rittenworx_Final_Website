---
import Layout from "../../layouts/Layout.astro";
import TrustCredentials from "../../components/TrustCredentials.astro";
import InlineQuoteForm from "../../components/InlineQuoteForm.astro";

const includedServices = [
  {
    title: "Siding & Wall Painting",
    items: [
      "Wood lap siding painting",
      "HardiePlank & fiber cement siding",
      "Vinyl siding painting (with proper primer)",
      "Brick & masonry painting",
      "Stucco exterior painting",
      "T1-11 & OSB siding painting",
      "Cedar shake & shingle painting",
      "Exterior wall surface preparation",
    ],
  },
  {
    title: "Trim, Doors & Shutters",
    items: [
      "Fascia board painting",
      "Soffit painting",
      "Window trim & casing painting",
      "Exterior door painting & staining",
      "Shutter painting and refinishing",
      "Corner board painting",
      "Garage door painting",
      "Decorative trim accent painting",
    ],
  },
  {
    title: "Decks, Porches & Fences",
    items: [
      "Deck staining and sealing",
      "Deck paint & solid-color stain application",
      "Porch floor painting",
      "Fence painting and staining",
      "Pergola & gazebo painting",
      "Handrail and baluster painting",
      "Post painting and waterproofing",
      "Pressure wash and prep before finishing",
    ],
  },
  {
    title: "Prep & Surface Repair",
    items: [
      "2,500 PSI power washing",
      "Scraping and sanding loose paint",
      "Caulking gaps around windows, doors, trim",
      "Spot priming bare wood and repairs",
      "Wood rot identification and minor repair",
      "Mildew treatment before painting",
      "Primer coat on all bare surfaces",
      "Drop cloth and masking protection",
    ],
  },
];

const paintBrands = [
  {
    name: "Sherwin-Williams Emerald",
    sheen: "Flat, Satin, Semi-Gloss",
    lifespan: "15–20 years",
    best: "Premium homes, maximum durability",
    feature: "Self-cleaning technology, extreme mildew resistance",
  },
  {
    name: "Sherwin-Williams Duration",
    sheen: "Satin, Semi-Gloss",
    lifespan: "12–15 years",
    best: "Most North Alabama homes",
    feature: "ClimateFlex technology handles temperature swings",
  },
  {
    name: "Benjamin Moore Aura Exterior",
    sheen: "Flat, Low Lustre, Semi-Gloss",
    lifespan: "15+ years",
    best: "Color-critical projects and historic homes",
    feature: "Color Lock technology prevents fading",
  },
  {
    name: "Behr Marquee Exterior",
    sheen: "Flat, Satin, Semi-Gloss",
    lifespan: "10–15 years",
    best: "Budget-conscious full repaints",
    feature: "One-coat hide, fade resistance",
  },
];

const commonProblems = [
  {
    problem: "Paint peeling, bubbling, or flaking off the siding",
    solution:
      "Peeling paint is almost always a moisture or adhesion failure. We identify the source — whether it's condensation, improper primer, or surface contamination — scrape all loose paint, treat the substrate, and apply a proper primer before recoating. We fix the root cause, not just the surface.",
  },
  {
    problem: "Exterior paint fading or chalking in just a few years",
    solution:
      "Alabama's intense UV exposure is brutal on paint film. We use only premium exterior paints engineered with UV-stabilizing resins (Sherwin-Williams Emerald or Duration) that resist chalking and retain color vibrancy for 12–15+ years instead of the 4–7 a budget paint delivers.",
  },
  {
    problem: "Mildew or mold growing on the painted surface",
    solution:
      "North Alabama's humidity is perfect for mildew growth on north-facing walls, under overhangs, and in shaded areas. We treat all affected surfaces with a mildewcide wash before painting and use mildew-resistant topcoats to stop regrowth from the start.",
  },
  {
    problem: "Caulk cracking and gaps opening around windows and trim",
    solution:
      "Failed caulk is the most common entry point for moisture damage and rot. We replace all cracked, shrunken, or missing caulk with premium paintable urethane caulk rated for 30+ years of elasticity before applying any paint.",
  },
  {
    problem: "Wood rot discovered under the old paint",
    solution:
      "Surface rot is the hidden enemy of every exterior repaint. We probe every piece of wood trim, fascia, and siding for soft spots, remove and replace deteriorated sections, and treat the surrounding wood with hardener before priming. A fresh coat of paint over rot just traps moisture and accelerates the damage.",
  },
  {
    problem: "Paint peeling off recently painted wood in less than two years",
    solution:
      "Premature failure almost always comes from skipping primer on bare wood or painting over a damp surface. We never paint over bare or repaired wood without spot-priming first, and we never paint when surface moisture readings are above the manufacturer's threshold.",
  },
];

const processSteps = [
  {
    step: 1,
    title: "Free On-Site Estimate",
    description:
      "We walk your home's exterior together, identify every surface condition issue, and discuss your color goals. You receive a written, itemized estimate that covers prep, materials, and labor with no hidden charges.",
    time: "Scheduled at your convenience",
  },
  {
    step: 2,
    title: "Power Washing",
    description:
      "We power wash the entire exterior at 2,500 PSI to remove dirt, mildew, loose paint, chalk, and airborne contaminants. Clean surfaces are essential for paint adhesion. We allow full drying time before any paint application.",
    time: "Day 1",
  },
  {
    step: 3,
    title: "Scraping, Sanding & Caulking",
    description:
      "All loose, flaking, or peeling paint is scraped and sanded to a feathered edge. Bare wood is primed. All gaps around windows, doors, trim, and utility penetrations are re-caulked with premium urethane caulk.",
    time: "Day 1–2 depending on scope",
  },
  {
    step: 4,
    title: "Masking & Drop Cloth Protection",
    description:
      "We mask all windows, doors, light fixtures, outlets, and landscaping with drop cloths and painter's tape. Your property is fully protected before any paint product is opened.",
    time: "Start of each paint day",
  },
  {
    step: 5,
    title: "Primer Application",
    description:
      "All bare wood repairs, raw wood surfaces, and stain-prone areas receive a full coat of premium bonding primer. Primer is not optional on exterior work. It's the layer that makes every topcoat perform.",
    time: "Day 2",
  },
  {
    step: 6,
    title: "Two-Coat Finish Application",
    description:
      "We apply two full coats of your chosen premium exterior finish at the manufacturer's specified wet mil thickness. Both brush and roll for proper penetration on textured surfaces. Spray work uses backrolling for maximum adhesion.",
    time: "Day 2–4 depending on scope",
  },
  {
    step: 7,
    title: "Final Walk-Through & Cleanup",
    description:
      "We conduct a detailed inspection of every surface, touch up any spots that need attention, remove all masking and drop cloths, and walk the property with you. We don't leave until you're completely satisfied.",
    time: "Final day",
  },
];

const faqs = [
  {
    question: "How much does exterior painting cost in Madison or Huntsville, AL?",
    answer:
      "Every job is different. The main cost drivers are square footage of paintable surface, number of stories, surface condition (the worse the prep needed, the more involved the job), and paint product selected. We provide free, detailed written estimates so you know exactly what you're paying for before any work begins.",
  },
  {
    question: "How long does exterior paint last in Alabama's climate?",
    answer:
      "With premium paint and proper prep, exterior paint should last 10–15 years in North Alabama. The biggest enemies are Alabama's intense summer UV, high humidity during spring and fall, and temperature swings between winter and summer. Skimping on prep or using low-grade paint cuts that lifespan to 4–7 years. We use Sherwin-Williams Emerald and Duration specifically because they're engineered to handle these conditions.",
  },
  {
    question: "What is the best time of year to paint a house exterior in Alabama?",
    answer:
      "Spring (March–May) and fall (September–November) are ideal in North Alabama. Temperatures between 50°F–85°F and lower humidity allow paint to cure properly without blistering or sagging. We can also paint in summer with careful scheduling around the heat of the day. We never paint when temperatures are below 50°F at application or expected to drop below 35°F overnight.",
  },
  {
    question: "Do you pressure wash before painting?",
    answer:
      "Yes, always. We power wash the entire exterior at 2,500 PSI before any other prep work begins. Paint applied over a dirty, chalky, or mildew-contaminated surface will fail in 1–3 years regardless of paint quality. The power wash step also reveals hidden surface conditions — soft wood, failed caulk, and loose paint that need to be addressed during prep.",
  },
  {
    question: "What paint brands do you use for exterior painting?",
    answer:
      "We primarily use Sherwin-Williams Emerald Exterior and Duration Exterior. For budget-conscious projects, Benjamin Moore Aura and Behr Marquee are solid alternatives. We never use contractor-grade paints that sacrifice UV resistance and film build for lower price. The paint is a small fraction of total project cost, but it determines how long the job lasts.",
  },
  {
    question: "Can you paint vinyl siding?",
    answer:
      "Yes, but with important caveats. Vinyl siding can be painted successfully if it's in good condition (not warped, cracked, or heavily faded to white chalking) and if we use the correct primer and a paint that's formulated for vinyl (most quality exterior paints qualify). We won't apply a color significantly darker than the original, as dark colors can cause vinyl panels to absorb too much heat and warp.",
  },
  {
    question: "Do you repair wood rot before painting?",
    answer:
      "Yes. We inspect every piece of wood trim, fascia, siding, and framing for soft, spongy rot before any prep work begins. Minor rot is treated with penetrating epoxy consolidant and filled with two-part wood filler before priming. Sections with significant structural rot are removed and replaced with new material. Painting over rot without treatment guarantees a short-lived repaint and accelerates structural damage.",
  },
  {
    question: "How do I prepare to have my exterior painted?",
    answer:
      "Very little is required from you. Before we arrive, please trim back overgrown shrubs or plants immediately adjacent to the siding, move potted plants away from the house perimeter, and make sure we have access to exterior water spigots for the power washer. We handle all masking, drop cloths, and cleanup. Pets should be kept indoors during painting days.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const serviceAreas = [
  { city: "Madison", note: "Primary service area" },
  { city: "Huntsville", note: "Serving this area" },
  { city: "Decatur", note: "Serving this area" },
  { city: "Athens", note: "Serving this area" },
  { city: "Harvest", note: "Serving this area" },
  { city: "Hampton Cove", note: "Serving this area" },
  { city: "Owens Cross Roads", note: "Serving this area" },
  { city: "Meridianville", note: "Serving this area" },
];
