              <svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
              </svg>
              {category.title}
            </h3>
            <ul class="space-y-2">
              {category.items.map((item) => (
                <li class="flex items-start gap-2 text-gray-700">
                  <svg class="w-4 h-4 text-green-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Paint Brands -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-gray-800 mb-4">Paint Products We Use</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          We use only premium exterior paints from proven manufacturers. No contractor-grade paint on your home.
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-lg shadow-sm border border-gray-100">
          <thead>
            <tr class="bg-blue-900 text-white">
              <th class="px-4 py-3 text-left font-semibold">Product</th>
              <th class="px-4 py-3 text-left font-semibold">Sheen Options</th>
              <th class="px-4 py-3 text-left font-semibold">Lifespan</th>
              <th class="px-4 py-3 text-left font-semibold">Best For</th>
              <th class="px-4 py-3 text-left font-semibold">Key Feature</th>
            </tr>
          </thead>
          <tbody>
            {paintBrands.map((paint, index) => (
              <tr class={index % 2 === 0 ? "bg-gray-50" : "bg-white"}>
                <td class="px-4 py-3 font-semibold text-blue-900">{paint.name}</td>
                <td class="px-4 py-3 text-gray-700">{paint.sheen}</td>
                <td class="px-4 py-3 text-gray-700">{paint.lifespan}</td>
                <td class="px-4 py-3 text-gray-700">{paint.best}</td>
                <td class="px-4 py-3 text-gray-600 text-sm">{paint.feature}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-center text-gray-500 text-sm mt-4">
        Not sure which product is right for your home's surface and budget? We'll recommend the best option during your free estimate.
      </p>
    </div>
  </section>

  <!-- Common Problems -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-800 mb-4">
          Exterior Paint Problems We Fix Permanently
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          If your home's exterior has any of these issues, a proper repaint solves them.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {commonProblems.map((item) => (
          <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-800 mb-2">{item.problem}</h3>
                <p class="text-gray-600 text-sm flex items-start gap-2">
                  <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item.solution}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Process -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
